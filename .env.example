# ==============================================================================
# 616 INTEL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or .env.production to version control.
# In production, configure these variables directly in your hosting platform (Vercel/Node).
# ==============================================================================

# Public Site Configuration
PUBLIC_SITE_URL=https://616intel.com
NODE_ENV=development

# Payment Security & Verification
# PAYMENT_SECRET_KEY: Used for HMAC-SHA256 generation and verification of payment tokens
PAYMENT_SECRET_KEY=your_secret_payment_signing_key_min_32_characters

# PAYMENT_WEBHOOK_SECRET: Secret used by payment provider (Razorpay/Stripe/Custom) to sign webhook payloads
PAYMENT_WEBHOOK_SECRET=your_webhook_signature_secret_key

# Administration & Moderation Bureau Security
# ADMIN_API_KEY: Bearer token required for internal moderation operations (approve, flag, remove)
# Never expose this to browser scripts or client-side bundles.
ADMIN_API_KEY=your_internal_admin_bearer_token_min_32_chars

# Anti-Abuse & Rate Limiting Controls
# Window in milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMISSIONS=5
RATE_LIMIT_MAX_PAYMENTS=10
