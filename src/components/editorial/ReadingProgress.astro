---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  id="reading-progress-bar"
  class:list={[
    "fixed top-0 left-0 right-0 h-0.5 bg-[var(--accent-red)] z-50 origin-left scale-x-0 transition-transform duration-75 ease-out pointer-events-none shadow-[0_0_8px_var(--accent-red)]",
    className
  ]}
  aria-hidden="true"
></div>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? winScroll / height : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, scrolled))})`;
    }, { passive: true });
  }

  setupReadingProgress();
  document.addEventListener('astro:page-load', setupReadingProgress);
</script>
