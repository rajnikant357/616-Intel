---
import { ArrowRight } from '@lucide/astro';

interface Props {
  title: string;
  tagline?: string;
  actionText?: string;
  actionHref?: string;
  class?: string;
}

const {
  title,
  tagline,
  actionText = 'VIEW ALL',
  actionHref,
  class: className = '',
} = Astro.props;
---

<div class:list={["flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8 pb-3 border-b border-[var(--intel-border)]", className]}>
  <div>
    {tagline && (
      <div class="flex items-center gap-2 text-[11px] font-mono font-bold tracking-widest text-[var(--intel-red)] uppercase mb-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--intel-red)] animate-pulse"></span>
        <span>{tagline}</span>
      </div>
    )}
    <div class="flex items-center gap-3">
      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black uppercase text-white tracking-tight leading-none red-accent-line">
        {title}
      </h2>
    </div>
  </div>

  {actionHref && (
    <a
      href={actionHref}
      class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-[var(--intel-muted)] hover:text-white transition-colors group select-none shrink-0"
    >
      <span>{actionText}</span>
      <ArrowRight class="w-3.5 h-3.5 text-[var(--intel-red)] transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
    </a>
  )}
</div>
