---
import { TriangleAlert, Eye } from '@lucide/astro';

interface Props {
  title?: string;
  warning?: string;
  class?: string;
}

const {
  title = 'POTENTIAL SPOILERS FOR UPCOMING RELEASES',
  warning = 'This intelligence briefing contains unreleased narrative details, character appearances, or plot points that may impact your viewing experience.',
  class: className = '',
} = Astro.props;

const uniqueId = `spoiler-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  class:list={[
    "relative my-8 rounded-sm border border-amber-500/30 bg-amber-950/10 p-5 overflow-hidden transition-all duration-300",
    className
  ]}
  id={uniqueId}
>
  <!-- Warning Header -->
  <div class="flex items-start gap-3.5">
    <div class="flex items-center justify-center w-8 h-8 rounded-xs bg-amber-500/20 text-amber-400 shrink-0 border border-amber-500/30">
      <TriangleAlert class="w-4 h-4" aria-hidden="true" />
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-400">
          SPOILER PROTOCOL ACTIVE
        </span>
      </div>
      <h3 class="text-base font-bold text-white tracking-tight mt-0.5">
        {title}
      </h3>
      <p class="text-xs text-[var(--text-secondary)] mt-1 leading-relaxed">
        {warning}
      </p>
    </div>
  </div>

  <!-- Hidden Content Area with Blur Overlay -->
  <div class="relative mt-4 pt-4 border-t border-amber-500/20">
    <div
      class="spoiler-content filter blur-md select-none transition-[filter,opacity] duration-500 ease-out pointer-events-none"
      aria-hidden="true"
    >
      <slot />
    </div>

    <!-- Toggle Reveal Overlay -->
    <div class="spoiler-overlay absolute inset-0 flex flex-col items-center justify-center bg-black/60 backdrop-blur-xs transition-opacity duration-300 p-4">
      <button
        type="button"
        class="spoiler-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-sm bg-amber-500 hover:bg-amber-400 text-black font-mono font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-[0_0_20px_rgba(245,158,11,0.4)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-black cursor-pointer active:scale-95"
        aria-expanded="false"
      >
        <Eye class="w-4 h-4" aria-hidden="true" />
        <span>REVEAL SPOILERS</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupSpoilerBlocks() {
    document.querySelectorAll('[id^="spoiler-"]').forEach((block) => {
      const btn = block.querySelector('.spoiler-btn') as HTMLButtonElement | null;
      const content = block.querySelector('.spoiler-content') as HTMLElement | null;
      const overlay = block.querySelector('.spoiler-overlay') as HTMLElement | null;

      if (!btn || !content || !overlay) return;

      btn.addEventListener('click', () => {
        const isRevealed = btn.getAttribute('aria-expanded') === 'true';

        if (!isRevealed) {
          btn.setAttribute('aria-expanded', 'true');
          content.classList.remove('blur-md', 'select-none', 'pointer-events-none');
          content.removeAttribute('aria-hidden');
          overlay.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => overlay.remove(), 350);
        }
      });
    });
  }

  // Run on initial load and View Transitions
  setupSpoilerBlocks();
  document.addEventListener('astro:page-load', setupSpoilerBlocks);
</script>
