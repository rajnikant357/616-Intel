<!-- Interactive Script for Custom Player (Autoplay Sound Unmute, Timestamps, Cinema Mode, Copy Link) -->
<script is:inline>
  (function initHeroTrailerPlayer() {
    const iframe = document.getElementById('trailer-youtube-iframe');
    const cinemaToggleBtn = document.getElementById('cinema-toggle-btn');
    const cinemaBackdrop = document.getElementById('cinema-backdrop');
    const playerContainer = document.getElementById('player-container');
    const copyBtn = document.getElementById('copy-trailer-link-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const timestampBtns = document.querySelectorAll('.timestamp-jump-btn');
    const audioUnlockOverlay = document.getElementById('audio-unlock-overlay');
    const audioToggleBtn = document.getElementById('audio-toggle-btn');
    const hudAudioIconOn = document.getElementById('hud-audio-icon-on');
    const hudAudioIconOff = document.getElementById('hud-audio-icon-off');
    const hudAudioText = document.getElementById('hud-audio-text');

    let isCinemaMode = false;
    let ytPlayer = null;
    let isAudioActive = false;

    // Helper: Send command to YouTube iframe via postMessage (guarantee array for args)
    function sendCommand(func, args = []) {
      if (!iframe || !iframe.contentWindow) return;
      const message = JSON.stringify({
        event: 'command',
        func: func,
        args: Array.isArray(args) ? args : (args ? [args] : []),
      });
      iframe.contentWindow.postMessage(message, '*');
    }

    function updateAudioUI(unmuted) {
      isAudioActive = unmuted;
      if (unmuted) {
        if (audioUnlockOverlay) {
          audioUnlockOverlay.classList.add('opacity-0', 'pointer-events-none');
          audioUnlockOverlay.style.display = 'none';
        }
        if (hudAudioIconOn) hudAudioIconOn.classList.remove('hidden');
        if (hudAudioIconOff) hudAudioIconOff.classList.add('hidden');
        if (hudAudioText) hudAudioText.textContent = 'SOUND ON (100%)';
        if (audioToggleBtn) {
          audioToggleBtn.classList.remove('bg-neutral-800');
          audioToggleBtn.classList.add('bg-[var(--intel-red)]');
        }
      } else {
        if (audioUnlockOverlay) {
          audioUnlockOverlay.classList.remove('opacity-0', 'pointer-events-none');
          audioUnlockOverlay.style.display = 'flex';
        }
        if (hudAudioIconOn) hudAudioIconOn.classList.add('hidden');
        if (hudAudioIconOff) hudAudioIconOff.classList.remove('hidden');
        if (hudAudioText) hudAudioText.textContent = 'UNMUTE AUDIO';
        if (audioToggleBtn) {
          audioToggleBtn.classList.remove('bg-[var(--intel-red)]');
          audioToggleBtn.classList.add('bg-neutral-800');
        }
      }
    }

    // Unmute & Full Volume Activation
    function unmuteAndPlay() {
      if (ytPlayer && typeof ytPlayer.unMute === 'function') {
        try {
          ytPlayer.unMute();
          ytPlayer.setVolume(100);
          ytPlayer.playVideo();
        } catch (e) {}
      }
      sendCommand('unMute', []);
      sendCommand('setVolume', [100]);
      sendCommand('playVideo', []);
      updateAudioUI(true);
    }

    function muteAudio() {
      if (ytPlayer && typeof ytPlayer.mute === 'function') {
        try {
          ytPlayer.mute();
        } catch (e) {}
      }
      sendCommand('mute', []);
      updateAudioUI(false);
    }

    // Toggle Audio button
    if (audioToggleBtn) {
      audioToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isAudioActive) {
          muteAudio();
        } else {
          unmuteAndPlay();
        }
      });
    }

    // Full player overlay click to unmute and enable controls
    if (audioUnlockOverlay) {
      audioUnlockOverlay.addEventListener('click', (e) => {
        e.stopPropagation();
        unmuteAndPlay();
      });
    }

    // Automatic audio unlock on any user gesture (Chrome / Safari Autoplay policy compliance)
    const gestureEvents = ['pointerdown', 'touchstart', 'click', 'keydown'];
    function onFirstUserGesture() {
      unmuteAndPlay();
      gestureEvents.forEach((evt) => {
        window.removeEventListener(evt, onFirstUserGesture, { capture: true });
      });
    }
    gestureEvents.forEach((evt) => {
      window.addEventListener(evt, onFirstUserGesture, { capture: true, once: true, passive: true });
    });

    // YouTube Iframe API setup
    function setupYTPlayer() {
      if (window.YT && window.YT.Player && !ytPlayer) {
        try {
          ytPlayer = new window.YT.Player('trailer-youtube-iframe', {
            events: {
              onReady: (event) => {
                try {
                  event.target.playVideo();
                } catch (e) {}

                // Attempt to activate audio if permitted by browser policy
                setTimeout(() => {
                  try {
                    event.target.unMute();
                    event.target.setVolume(100);
                    if (event.target.isMuted()) {
                      updateAudioUI(false);
                    } else {
                      updateAudioUI(true);
                    }
                  } catch (e) {
                    updateAudioUI(false);
                  }
                }, 300);
              },
              onStateChange: (event) => {
                if (event.data === window.YT.PlayerState.PLAYING) {
                  try {
                    if (event.target.isMuted()) {
                      updateAudioUI(false);
                    } else {
                      updateAudioUI(true);
                    }
                  } catch (e) {}
                }
              }
            }
          });
        } catch (e) {}
      }
    }

    // Inject YouTube API script if needed
    if (!window.YT) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      const firstScript = document.getElementsByTagName('script')[0];
      firstScript?.parentNode?.insertBefore(tag, firstScript);
    }

    const prevReady = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = function() {
      if (typeof prevReady === 'function') prevReady();
      setupYTPlayer();
    };
    if (window.YT && window.YT.Player) {
      setupYTPlayer();
    }

    // Direct postMessage initialization & retries on load
    if (iframe) {
      iframe.addEventListener('load', () => {
        iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening' }), '*');
        sendCommand('playVideo', []);
        setTimeout(() => sendCommand('playVideo', []), 300);
        setTimeout(() => sendCommand('playVideo', []), 1000);
      });
    }

    window.addEventListener('message', (event) => {
      try {
        const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        if (data && (data.event === 'onReady' || data.info?.playerState === 1)) {
          unmuteAndPlay();
        }
      } catch (e) {}
    });

    // 2. Timestamp Jump Handling
    timestampBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const secs = parseInt(btn.getAttribute('data-seconds') || '0', 10);
        if (ytPlayer && typeof ytPlayer.seekTo === 'function') {
          try {
            ytPlayer.seekTo(secs, true);
          } catch (e) {}
        }
        sendCommand('seekTo', [secs, true]);
        unmuteAndPlay();

        // Smooth scroll to player stage if off screen
        const rect = playerContainer?.getBoundingClientRect();
        if (rect && (rect.top < 0 || rect.bottom > window.innerHeight)) {
          playerContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    // 3. Cinema Dim Lights Mode
    if (cinemaToggleBtn && cinemaBackdrop && playerContainer) {
      cinemaToggleBtn.addEventListener('click', () => {
        isCinemaMode = !isCinemaMode;
        if (isCinemaMode) {
          cinemaBackdrop.classList.remove('opacity-0', 'pointer-events-none');
          cinemaBackdrop.classList.add('opacity-90');
          playerContainer.classList.add('ring-4', 'ring-[var(--intel-red)]/50');
        } else {
          cinemaBackdrop.classList.add('opacity-0', 'pointer-events-none');
          cinemaBackdrop.classList.remove('opacity-90');
          playerContainer.classList.remove('ring-4', 'ring-[var(--intel-red)]/50');
        }
      });

      cinemaBackdrop.addEventListener('click', () => {
        isCinemaMode = false;
        cinemaBackdrop.classList.add('opacity-0', 'pointer-events-none');
        cinemaBackdrop.classList.remove('opacity-90');
        playerContainer.classList.remove('ring-4', 'ring-[var(--intel-red)]/50');
      });
    }

    // 4. Copy Trailer Link Action
    if (copyBtn && copyBtnText) {
      copyBtn.addEventListener('click', async () => {
        const trailerUrl = `${window.location.origin}/#hero-doomsday-trailer`;
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(trailerUrl);
          } else {
            const input = document.createElement('input');
            input.value = trailerUrl;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
          }
          copyBtnText.textContent = 'Link Copied!';
          setTimeout(() => {
            copyBtnText.textContent = 'Share Trailer';
          }, 2500);
        } catch {
          copyBtnText.textContent = 'Link Copied!';
        }
      });
    }
  })();
</script>
