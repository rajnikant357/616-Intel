---
import { 
  Play, 
  ExternalLink, 
  Share2, 
  Maximize2, 
  Sparkles, 
  Film, 
  Clock, 
  Flame, 
  CheckCircle2, 
  Clapperboard, 
  Ticket, 
  ShieldAlert,
  Tv,
  Calendar,
  Layers,
  Volume2,
  VolumeX
} from '@lucide/astro';

interface Props {
  videoId?: string;
  posterImage?: string;
  title?: string;
  tagline?: string;
  isHero?: boolean;
}

const {
  videoId = '98dc5qNpPjw',
  posterImage = '/Final trailer.png',
  title = 'AVENGERS: DOOMSDAY',
  tagline = 'OFFICIAL MARVEL STUDIOS FINAL TRAILER',
  isHero = true,
} = Astro.props;

const siteOrigin = Astro.site?.origin || 'https://616intel.prometrion.com';

const timestamps = [
  { time: '0:00', seconds: 0, label: 'Sacred Timeline Incursion & The Void', badge: 'PROLOGUE' },
  { time: '0:48', seconds: 48, label: 'Victor von Doom (RDJ) Dons the Mask', badge: 'REVEAL' },
  { time: '1:25', seconds: 85, label: 'The Fantastic Four & The Council of Reeds', badge: 'COUNCIL' },
  { time: '2:10', seconds: 130, label: 'The Void vs. Sentry Cosmic Clash', badge: 'COMBAT' },
  { time: '2:45', seconds: 165, label: 'The Multiverse War & Battleworld Inevitability', badge: 'CLIMAX' },
];

const castMembers = [
  { actor: 'Robert Downey Jr.', character: 'Victor von Doom / Doctor Doom', universe: 'Latveria / Multiverse Variant', note: 'Primary Antagonist & Master of Sorcery/Science' },
  { actor: 'Pedro Pascal', character: 'Reed Richards / Mister Fantastic', universe: 'Earth-1960s (Fantastic Four)', note: 'Leading the Multiverse Council of Reeds' },
  { actor: 'Tom Holland', character: 'Peter Parker / Spider-Man', universe: 'Earth-616', note: 'Frontline Avenger facing the Incursion Collapse' },
  { actor: 'Anthony Mackie', character: 'Sam Wilson / Captain America', universe: 'Earth-616', note: 'Commanding the New Avengers Coalition' },
  { actor: 'Florence Pugh', character: 'Yelena Belova', universe: 'Earth-616 (Thunderbolts)', note: 'Covert Black Ops Strike Team Lead' },
  { actor: 'Hugh Jackman', character: 'Logan / Wolverine', universe: 'Fox Universe Anchor', note: 'Mutant Incursion Vanguard alongside Deadpool' },
  { actor: 'Sebastian Stan', character: 'Bucky Barnes / Winter Soldier', universe: 'Earth-616', note: 'Tactical Ground Operations Commander' },
  { actor: 'Benedict Cumberbatch', character: 'Doctor Stephen Strange', universe: 'Earth-616', note: 'Navigating Multiversal Incursion Fractures' },
];

const faqs = [
  {
    q: 'When is the official release date for Avengers: Doomsday?',
    a: 'Marvel Studios has slated Avengers: Doomsday for global theatrical release on December 18, 2026. The film will be distributed in IMAX 70mm, IMAX Dual 4K Laser, Dolby Cinema, and standard high-definition formats worldwide.',
  },
  {
    q: 'Is Robert Downey Jr. playing Iron Man or Doctor Doom in this trailer?',
    a: 'Robert Downey Jr. is portraying Victor von Doom (Doctor Doom), not Tony Stark. The Russo Brothers and Kevin Feige confirmed at San Diego Comic-Con that Downey is taking on the definitive mantle of Marvel\'s most iconic sovereign dictator and sorcerer, presenting a fresh, terrifying threat to the entire Multiverse.',
  },
  {
    q: 'Who is directing Avengers: Doomsday?',
    a: 'Anthony and Joe Russo (The Russo Brothers) return to direct both Avengers: Doomsday and Avengers: Secret Wars, following their record-breaking MCU directorial achievements on Captain America: The Winter Soldier, Civil War, Infinity War, and Avengers: Endgame.',
  },
  {
    q: 'How does the final trailer connect to Secret Wars and Battleworld?',
    a: 'The final trailer showcases catastrophic universal incursions—collisions where alternate realities crash into each other until only fragments remain. As Victor von Doom consolidates multiversal power from the TVA, the Void, and fractured timelines, Doomsday serves as the direct narrative catalyst creating the patchwork reality known as Battleworld for Avengers: Secret Wars.',
  },
];
---

<section 
  id="hero-doomsday-trailer" 
  class="relative w-full pt-4 pb-12 sm:pt-6 sm:pb-16 lg:pb-20 bg-gradient-to-b from-[var(--intel-obsidian)] via-[var(--intel-void)] to-[var(--intel-charcoal)] border-b border-[var(--intel-border)] overflow-hidden" 
  aria-label="Lead Hero: Avengers Doomsday Official Final Trailer"
>
  <!-- Ambient background glow accents -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[950px] h-[450px] bg-red-950/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 right-0 w-[500px] h-[300px] bg-emerald-950/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Fullscreen Cinema Dim Mode Backdrop (Toggled via JS) -->
  <div id="cinema-backdrop" class="fixed inset-0 bg-black/95 z-40 transition-opacity duration-500 opacity-0 pointer-events-none" aria-hidden="true"></div>

  <div class="container-editorial relative z-10">

    <!-- CUSTOMIZED PLAYER FRAME WITH INSTANT AUTOPLAY (AT THE VERY FRONT) -->
    <div id="player-container" class="relative w-full max-w-5xl mx-auto rounded-xs border-2 border-[var(--intel-border-strong)] bg-black shadow-[0_25px_70px_-15px_rgba(0,0,0,0.95)] overflow-hidden transition-all duration-300 z-50">
      
      <!-- Custom Player Bezel Top Header (HUD & Tactical Telemetry) -->
      <div class="flex items-center justify-between px-3 sm:px-4 py-2.5 bg-[var(--intel-charcoal)] border-b border-[var(--intel-border)] font-mono text-[11px] select-none text-neutral-300">
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
            <span class="font-bold text-white tracking-wider uppercase hidden xs:inline">AUTOPLAYING 4K 60FPS</span>
            <span class="font-bold text-white tracking-wider uppercase xs:hidden">AUTOPLAY</span>
          </div>
          <span class="text-neutral-600">|</span>
          <span class="text-neutral-400 hidden sm:inline">OFFICIAL YOUTUBE 4K EMBED</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 rounded-xs bg-red-950/80 border border-red-500/40 text-red-300 text-[10px] font-bold">
            IMAX 1.43:1
          </span>
          <span class="px-1.5 py-0.5 rounded-xs bg-neutral-800 text-neutral-300 text-[10px] font-bold hidden sm:inline">
            DOLBY ATMOS 7.1
          </span>

          <!-- Audio Status & Unmute Toggle Button -->
          <button
            type="button"
            id="audio-toggle-btn"
            class="px-2.5 py-1 rounded-xs bg-[var(--intel-red)] hover:bg-red-700 text-white transition-all flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider cursor-pointer shadow-[0_0_12px_rgba(225,6,0,0.6)]"
            title="Toggle Audio (Sound On/Off)"
            aria-label="Toggle Audio"
          >
            <Volume2 class="w-3.5 h-3.5 text-white" id="hud-audio-icon-on" />
            <VolumeX class="w-3.5 h-3.5 text-neutral-300 hidden" id="hud-audio-icon-off" />
            <span id="hud-audio-text">AUDIO ON (100%)</span>
          </button>

          <button 
            type="button" 
            id="cinema-toggle-btn" 
            class="px-2 py-0.5 rounded-xs bg-[var(--intel-elevated)] hover:bg-[var(--intel-surface-hover)] border border-[var(--intel-border)] text-white hover:text-[var(--intel-red)] transition-colors flex items-center gap-1 text-[10px] uppercase font-bold cursor-pointer"
            title="Toggle Theater Lights (Dim Background)"
            aria-label="Toggle Theater Lights"
          >
            <Tv class="w-3 h-3 text-[var(--intel-red)]" />
            <span class="hidden sm:inline">Cinema Dim</span>
          </button>
        </div>
      </div>

      <!-- Player Stage (Autoplaying YouTube IFrame with Full Audio) -->
      <div id="video-stage" class="relative w-full aspect-video bg-black overflow-hidden group">
        
        <!-- The Autoplaying YouTube IFrame (Rendered with autoplay=1&mute=1 for guaranteed instant playback) -->
        <iframe 
          id="trailer-youtube-iframe"
          class="w-full h-full border-0 absolute inset-0 z-10" 
          src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1&controls=1&rel=0&modestbranding=1&enablejsapi=1`}
          title="Marvel Studios Avengers: Doomsday Official Final Trailer"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; speaker; audio" 
          allowfullscreen
        ></iframe>

        <!-- Audio Unlock Overlay (Active while video autoplays muted until first click/tap) -->
        <div 
          id="audio-unlock-overlay" 
          class="absolute inset-0 z-20 flex items-center justify-center bg-black/15 hover:bg-black/35 transition-colors cursor-pointer group"
          title="Click anywhere to turn audio on"
        >
          <div class="px-5 py-3 rounded-full bg-black/90 border-2 border-[var(--intel-red)] text-white font-mono text-xs sm:text-sm font-bold uppercase tracking-wider flex items-center gap-2.5 shadow-[0_0_30px_rgba(225,6,0,0.85)] group-hover:scale-105 transition-all animate-pulse">
            <Volume2 class="w-4 h-4 text-[var(--intel-red)] shrink-0" />
            <span>PLAYING AUTONOMOUSLY • CLICK FOR FULL AUDIO 🔊</span>
          </div>
        </div>

      </div>

      <!-- Custom Player Bottom Command Deck / Timestamp Jump Bar -->
      <div class="p-3 sm:p-4 bg-[var(--intel-charcoal)] border-t border-[var(--intel-border)] select-none">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-3 pb-3 border-b border-[var(--intel-border-subtle)]">
          <div class="flex items-center gap-2 text-xs font-mono">
            <span class="text-[var(--intel-red)] font-bold uppercase tracking-wider flex items-center gap-1.5">
              <Flame class="w-3.5 h-3.5" />
              <span>KEY TRAILER MOMENTS &amp; TIMESTAMPS:</span>
            </span>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center gap-2 font-mono text-xs">
            <a
              href="/avengers-doomsday"
              class="px-3 py-1.5 rounded-xs bg-[var(--intel-red)] hover:bg-[var(--intel-red-hover)] text-white font-bold transition-all shadow-[0_0_12px_rgba(225,6,0,0.35)] flex items-center gap-1.5 text-[11px]"
              aria-label="All Doomsday Trailers & Videos"
            >
              <Clapperboard class="w-3.5 h-3.5" />
              <span>All Doomsday Videos ({14})</span>
            </a>

            <button
              type="button"
              id="copy-trailer-link-btn"
              class="px-3 py-1.5 rounded-xs bg-[var(--intel-obsidian)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-200 hover:text-white transition-colors flex items-center gap-1.5 cursor-pointer text-[11px]"
              aria-label="Copy Trailer Link"
            >
              <Share2 class="w-3.5 h-3.5 text-[var(--intel-red)]" />
              <span id="copy-btn-text">Share Trailer</span>
            </button>

            <a
              href={`https://www.youtube.com/watch?v=${videoId}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xs bg-[var(--intel-obsidian)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-200 hover:text-white transition-colors flex items-center gap-1.5 text-[11px]"
              aria-label="Watch on YouTube"
            >
              <span>YouTube 4K</span>
              <ExternalLink class="w-3.5 h-3.5 text-[var(--intel-red)]" />
            </a>

            <a
              href="/booking"
              class="px-3 py-1.5 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-white font-bold transition-all flex items-center gap-1.5 text-[11px]"
            >
              <Ticket class="w-3.5 h-3.5 text-[var(--intel-red)]" />
              <span>Book Tickets</span>
            </a>
          </div>
        </div>

        <!-- Interactive Timestamp Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2 font-mono text-xs">
          {timestamps.map((ts) => (
            <button
              type="button"
              class="timestamp-jump-btn text-left p-2 rounded-xs bg-[var(--intel-obsidian)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border-subtle)] hover:border-[var(--intel-red)]/50 transition-all cursor-pointer group"
              data-seconds={ts.seconds}
              aria-label={`Jump to ${ts.time}: ${ts.label}`}
            >
              <div class="flex items-center justify-between text-[10px] mb-1">
                <span class="text-[var(--intel-red)] font-bold">{ts.time}</span>
                <span class="px-1 py-0.2 rounded-xs bg-neutral-800 text-neutral-400 text-[9px] group-hover:bg-red-950 group-hover:text-red-300">
                  {ts.badge}
                </span>
              </div>
              <p class="text-[11px] text-neutral-300 leading-snug line-clamp-1 group-hover:text-white">
                {ts.label}
              </p>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- PROMINENT VAULT LINK: ALL TRAILERS AND VIDEOS FOR DOOMSDAY (REDIRECTS TO /avengers-doomsday) -->
    <div class="mt-4 mb-3 max-w-5xl mx-auto">
      <a 
        href="/avengers-doomsday" 
        class="group relative flex flex-col sm:flex-row items-center justify-between gap-4 p-4 sm:p-5 rounded-xs bg-gradient-to-r from-red-950/80 via-[var(--intel-charcoal)] to-[var(--intel-obsidian)] border border-[var(--intel-red)]/50 hover:border-[var(--intel-red)] shadow-[0_0_20px_rgba(225,6,0,0.25)] hover:shadow-[0_0_35px_rgba(225,6,0,0.45)] transition-all duration-300"
        title="View All 14 Official Avengers: Doomsday Trailers, Teasers & Videos"
      >
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xs bg-[var(--intel-red)] flex items-center justify-center text-white shadow-[0_0_15px_rgba(225,6,0,0.6)] group-hover:scale-105 transition-transform shrink-0">
            <Film class="w-5 h-5" />
          </div>
          <div>
            <span class="text-[11px] font-mono uppercase tracking-widest text-red-400 font-bold block flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              ALL DOOMSDAY VIDEOS &amp; TRAILERS • DEDICATED ARCHIVE
            </span>
            <h3 class="font-display font-bold text-base sm:text-lg text-white uppercase group-hover:text-red-400 transition-colors">
              Watch All 14 Avengers: Doomsday Trailers, Teasers &amp; Special Looks &rarr;
            </h3>
            <p class="text-xs text-neutral-300 font-sans hidden sm:block">
              Explore Robert Downey Jr. Doctor Doom reveals, X-Men &amp; Steve Rogers return spots, CinemaCon leaks, and individual scene breakdowns.
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 px-4 py-2.5 rounded-xs bg-[var(--intel-red)] group-hover:bg-[var(--intel-red-hover)] text-white font-mono text-xs font-bold uppercase tracking-wider shrink-0 transition-all shadow-md">
          <span>ALL DOOMSDAY VIDEOS</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </div>
      </a>
    </div>

    <!-- HEADINGS & CAPTION (NOW PLACED UNDER THE TRAILER VIDEO WITH REGULAR SIZE FONT) -->
    <header class="mt-4 sm:mt-6 max-w-5xl mx-auto text-left">
      <!-- Status & Telemetry Badges -->
      <div class="flex flex-wrap items-center gap-2.5 mb-3 font-mono text-xs font-bold tracking-wider uppercase">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-xs bg-[var(--intel-red)] text-white shadow-[0_0_12px_rgba(225,6,0,0.5)] text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
          <span>HERO WIRE • 4K STREAM</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-xs bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-[11px]">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-400" />
          <span>STREAMING LIVE NOW</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-xs bg-neutral-900 border border-neutral-700 text-neutral-300 text-[11px]">
          <Clock class="w-3.5 h-3.5 text-[var(--intel-red)]" />
          <span>RUNTIME: 03:18</span>
        </span>
        <span class="text-neutral-500 hidden md:inline">|</span>
        <span class="text-[var(--intel-muted)] hidden md:inline font-normal text-[11px]">CLASSIFIED MARVEL PHASE 6 DOSSIER</span>
      </div>

      <!-- REGULAR SIZE HEADINGS -->
      <div class="space-y-1">
        <span class="block font-mono text-xs font-bold text-[var(--intel-red)] tracking-widest uppercase">
          {tagline}
        </span>
        <h1 
          id="doomsday-trailer-heading" 
          class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl tracking-tight text-white uppercase leading-snug"
        >
          {title}: <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-rose-400 to-amber-300">OFFICIAL FINAL TRAILER DOSSIER</span>
        </h1>
      </div>

      <!-- CAPTION -->
      <p class="mt-3 font-sans text-sm sm:text-base text-neutral-300 max-w-4xl leading-relaxed">
        The Multiverse is dying. Stream the official full-length final trailer for <strong class="text-white">Avengers: Doomsday</strong> above as <strong class="text-white">Robert Downey Jr.</strong> ascends as <strong class="text-white">Victor von Doom</strong> alongside the Fantastic Four, Sentry, and the surviving Avengers under the direction of Anthony &amp; Joe Russo.
      </p>
    </header>

    <!-- SEO UNDER IT: IN-DEPTH DOSSIER, BREAKDOWN, CAST MATRIX & FAQ -->
    <article class="mt-12 sm:mt-16 pt-10 border-t border-[var(--intel-border)]" aria-label="Avengers Doomsday Trailer Breakdown & Intelligence Dossier">
      
      <!-- Dossier Header -->
      <div class="max-w-4xl mx-auto mb-10 text-center">
        <span class="px-2.5 py-1 rounded-xs bg-[var(--intel-red)]/15 border border-[var(--intel-red)]/30 text-[var(--intel-red)] font-mono text-xs font-bold uppercase tracking-widest inline-block mb-3">
          DEEP-DIVE TRAILER ANALYSIS • EXCLUSIVE INTELLIGENCE
        </span>
        <h2 class="font-display font-black text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight text-white mb-4">
          AVENGERS: DOOMSDAY TRAILER BREAKDOWN &amp; STORY SECRETS
        </h2>
        <p class="font-sans text-neutral-300 text-sm sm:text-base leading-relaxed">
          Comprehensive scene-by-scene analysis, multiversal canon confirmations, casting dossiers, and narrative roadmaps leading into the historic Phase 6 incursion conflict.
        </p>
      </div>

      <!-- SECTION 1: SCENE-BY-SCENE ANALYSIS (Rich Editorial Prose with High-Value Keywords) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        <div class="lg:col-span-8 space-y-6 text-neutral-300 font-sans text-sm sm:text-base leading-relaxed">
          
          <div class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-white uppercase tracking-wide mb-3 flex items-center gap-2">
              <span class="text-[var(--intel-red)] font-mono text-lg">01.</span>
              <span>The Incursion Catastrophe &amp; The Void Resurgence</span>
            </h3>
            <p class="mb-3">
              The final trailer for <strong class="text-white">Avengers: Doomsday</strong> wastes no time confirming the catastrophic reality of universal incursions. As established across <em class="text-neutral-200">Doctor Strange in the Multiverse of Madness</em> and <em class="text-neutral-200">Loki Season 2</em>, when two universes collide at their dimensional epicenter, both perish entirely unless one is obliterated.
            </p>
            <p>
              Opening frames depict the shattered sky over Manhattan cracking into kaleidoscopic cosmic purple fissures. Alternate realities bleed together, revealing glimpses of the dead temporal wastelands of <strong class="text-white">The Void</strong> and the remains of Earth-838. With time itself failing to sustain parallel branches, the surviving heroes of Earth-616 realize that standard Avengers protocols are utterly obsolete against multiversal annihilation.
            </p>
          </div>

          <div class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-white uppercase tracking-wide mb-3 flex items-center gap-2">
              <span class="text-[var(--intel-red)] font-mono text-lg">02.</span>
              <span>Robert Downey Jr. as Victor von Doom: The Latverian Monarch</span>
            </h3>
            <p class="mb-3">
              The focal centerpiece of the trailer is the jaw-dropping reveal of <strong class="text-white">Robert Downey Jr.</strong> clad in authentic Latverian battle armor, draped in royal emerald green velvet, and donning the cold hand-forged titanium mask of <strong class="text-white">Victor von Doom</strong>.
            </p>
            <p>
              Unlike past cinematic adaptations, the Russo Brothers have faithfully integrated Doctor Doom's mastery of both cutting-edge hyper-technology and ancient mystic sorcery. Speaking through the resonant acoustic filter of his mask, Doom declares that while the Avengers fought to preserve temporal chaos, he alone possesses the will and sovereign intellect to reconstruct existence from the ashes of the collapsing multiverse.
            </p>
          </div>

          <div class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-white uppercase tracking-wide mb-3 flex items-center gap-2">
              <span class="text-[var(--intel-red)] font-mono text-lg">03.</span>
              <span>The Fantastic Four &amp; The Multiverse Council of Reeds</span>
            </h3>
            <p class="mb-3">
              Crossing over directly from their alternate retro-futuristic 1960s universe, <strong class="text-white">Pedro Pascal's Reed Richards (Mister Fantastic)</strong>, <strong class="text-white">Vanessa Kirby (Sue Storm)</strong>, <strong class="text-white">Joseph Quinn (Johnny Storm)</strong>, and <strong class="text-white">Ebon Moss-Bachrach (The Thing)</strong> breach Earth-616 aboard the Excelsior interdimensional vessel.
            </p>
            <p>
              Trailer sequences highlight an intellectual standoff between Reed Richards and Doctor Doom, establishing their legendary comic rivalry. Richards warns the Avengers that Doom is systematically absorbing multiversal anchors and temporal looms, attempting to assemble a singular omnipotent realm under his unilateral dominion—the direct foundation of <strong class="text-white">Battleworld</strong>.
            </p>
          </div>

          <div class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-white uppercase tracking-wide mb-3 flex items-center gap-2">
              <span class="text-[var(--intel-red)] font-mono text-lg">04.</span>
              <span>Cosmic Power Scales: The Void vs. Doctor Doom &amp; Sentry</span>
            </h3>
            <p>
              The climax of the trailer teases the most physically destructive clash in Marvel Studios history: the cosmic manifestation of <strong class="text-white">The Void</strong> (the apocalyptic entity born from Robert Reynolds / The Sentry) confronting Doctor Doom. As dark matter tendrils engulf entire mountain ranges, Doom deploys mystical crimson wards and Latverian anti-matter siphon rings to contain the entity's 1,000,000 exploding suns of primordial chaos.
            </p>
          </div>

        </div>

        <!-- FAST FACTS DOSSIER SIDEBAR -->
        <div class="lg:col-span-4 space-y-5">
          <div class="p-5 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
            <div class="flex items-center gap-2 font-mono text-xs font-bold text-[var(--intel-red)] uppercase mb-3 pb-2 border-b border-[var(--intel-border-subtle)]">
              <ShieldAlert class="w-4 h-4" />
              <span>PRODUCTION DOSSIER OVERVIEW</span>
            </div>

            <dl class="space-y-3 font-mono text-xs">
              <div>
                <dt class="text-[var(--intel-muted)] text-[10px] uppercase">PROJECT TITLE</dt>
                <dd class="text-white font-bold text-sm">Marvel Studios' Avengers: Doomsday</dd>
              </div>
              <div>
                <dt class="text-[var(--intel-muted)] text-[10px] uppercase">DIRECTORS</dt>
                <dd class="text-white font-bold">Anthony Russo &amp; Joe Russo (The Russo Brothers)</dd>
