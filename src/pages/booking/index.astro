---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { 
  Ticket, 
  ExternalLink, 
  Clock, 
  Sparkles, 
  ShieldCheck, 
  ShieldAlert, 
  Film, 
  Info, 
  Building2, 
  Compass, 
  CheckCircle2, 
  ArrowUpRight,
  MapPin,
  Calendar
} from '@lucide/astro';

const siteUrl = Astro.site?.origin || 'https://www.616intel.prometrion.com';

const bookingSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Movie Tickets & Advance Premiere Booking Platforms | 616 Intel',
    description: 'Official advance ticket booking and premiere platform guide for Avengers: Doomsday (18 Dec 2026) and Marvel blockbusters. Redirects to verified ticketing portals including District, MakeMyTrip, BookMyShow, and Fandango.',
    url: `${siteUrl}/booking`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Ticket Platforms', item: `${siteUrl}/booking` },
    ],
  },
];

const platforms = [
  {
    name: 'District',
    subtitle: 'District by Zomato',
    url: 'https://www.district.in',
    tag: 'POPULAR • LIVE EVENTS & MOVIES',
    tagColor: 'text-amber-400 bg-amber-950/80 border-amber-500/40',
    description: 'Premier entertainment booking platform featuring exclusive cinema pre-sales, opening night fan screenings, and live experiences.',
    perks: ['Exclusive Pre-Sale Access', 'Instant Mobile QR Entry', 'Special Premiere Fan Screenings'],
    featured: true,
  },
  {
    name: 'MakeMyTrip',
    subtitle: 'MakeMyTrip Experiences & Cinema',
    url: 'https://www.makemytrip.com',
    tag: 'OFFICIAL PARTNER • EXPERIENCES',
    tagColor: 'text-cyan-400 bg-cyan-950/80 border-cyan-500/40',
    description: 'Comprehensive travel & entertainment portal for booking theatrical passes, IMAX packages, and opening weekend premiere visits.',
    perks: ['Cinema & Event Passes', 'Convenient City-Wide Booking', 'Integrated Weekend Packages'],
    featured: true,
  },
  {
    name: 'BookMyShow',
    subtitle: 'BookMyShow Multiplex Network',
    url: 'https://in.bookmyshow.com',
    tag: 'PAN-INDIA • REAL-TIME SEATS',
    tagColor: 'text-rose-400 bg-rose-950/80 border-rose-500/40',
    description: 'Real-time interactive seating for IMAX 70mm, PVR INOX, Cinepolis, and midnight incursion screenings nationwide.',
    perks: ['Live Interactive Seat Selector', 'All Major Multiplex Chains', 'Food & Beverage Advance Combos'],
    featured: true,
  },
  {
    name: 'Fandango',
    subtitle: 'Fandango North America & Global',
    url: 'https://www.fandango.com',
    tag: 'US & GLOBAL • AMC & REGAL',
    tagColor: 'text-purple-400 bg-purple-950/80 border-purple-500/40',
    description: 'Leading North American ticketing destination for AMC Lincoln Square IMAX 70mm, Regal RPX, and Cinemark XD.',
    perks: ['AMC Lincoln Square 70mm Access', 'Guaranteed Reserved Seating', 'VIP Fan Club Perks'],
    featured: false,
  },
  {
    name: 'Paytm Insider',
    subtitle: 'Paytm Insider Events & Screenings',
    url: 'https://insider.in',
    tag: 'FAN CLUBS • MIDNIGHT INCURSIONS',
    tagColor: 'text-emerald-400 bg-emerald-950/80 border-emerald-500/40',
    description: 'Curated comic fan club events, midnight premiere incursions, and Marvel Multiverse community screenings.',
    perks: ['Exclusive Fan Community Screenings', 'Collector Merchandise Bundles', 'Early Bird Entry'],
    featured: false,
  },
  {
    name: 'PVR INOX',
    subtitle: 'PVR INOX Direct Theatrical Booking',
    url: 'https://www.pvrcinemas.com',
    tag: 'DIRECT CHAIN • ICE & INSIGNIA',
    tagColor: 'text-blue-400 bg-blue-950/80 border-blue-500/40',
    description: 'Direct booking portal for PVR ICE, INOX Megaplex, IMAX Dual Laser, and Insignia luxury auditoriums.',
    perks: ['Zero Convenience Fee Days', 'Insignia Luxury Dining Experience', 'IMAX Laser Projection'],
    featured: false,
  },
];

const upcomingMovies = [
  {
    title: 'Avengers: Doomsday',
    releaseDate: 'December 18, 2026',
    format: 'IMAX 70mm • Dolby Atmos • 4DX',
    synopsis: 'Robert Downey Jr. returns to the MCU as Victor von Doom alongside Pedro Pascal, Tom Holland, and Hugh Jackman under the direction of Anthony and Joe Russo.',
    status: 'Advance Presale Wire Open',
    highlight: true,
  },
  {
    title: 'Fantastic Four: First Steps',
    releaseDate: 'July 25, 2025',
    format: 'IMAX Dual Laser • 3D • Dolby Vision',
    synopsis: 'Marvel’s First Family battles Galactus and the Silver Surfer in an alternate retro-futuristic 1960s timeline.',
    status: 'Upcoming Booking',
    highlight: false,
  },
  {
    title: 'Spider-Man: Beyond the Spider-Verse',
    releaseDate: 'TBA 2026 / 2027',
    format: 'IMAX • Dolby Cinema',
    synopsis: 'Miles Morales traverses alternate dimensions to rescue his family and unite the Spider-Society against the Spot.',
    status: 'Tracking Presales',
    highlight: false,
  },
];
---

<BaseLayout
  title="Movie Tickets & Advance Booking Redirection Hub | 616 Intel"
  description="Direct redirection to official movie booking platforms including District, MakeMyTrip, BookMyShow, and Fandango for Avengers: Doomsday and Marvel theatrical premieres."
  keywords="avengers doomsday tickets, district tickets, make my trip booking, bookmyshow marvel tickets, fandango avengers, movie ticket redirection, advance booking doomsday"
  jsonLd={bookingSchema}
>
  <div class="container-editorial py-6 md:py-10 max-w-6xl mx-auto">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Ticket Booking Hub' },
      ]}
    />

    <!-- Hero Header -->
    <header class="mb-10 pb-8 border-b border-[var(--intel-border)]">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-2.5 py-1 rounded-xs bg-[var(--intel-red)] text-white font-mono text-xs font-bold tracking-widest uppercase shadow-[0_0_12px_rgba(225,6,0,0.4)]">
          TICKET REDIRECTION WIRE
        </span>
        <span class="px-2.5 py-1 rounded-xs bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 font-mono text-xs font-bold tracking-wider uppercase">
          OFFICIAL BOOKING PLATFORMS
        </span>
        <span class="px-2.5 py-1 rounded-xs bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-300 font-mono text-xs font-medium">
          EXTERNAL CHECKOUT ONLY
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8">
          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.05] mb-4">
            Movie Tickets &amp; Advance Booking
            <span class="block text-2xl sm:text-3xl lg:text-4xl font-display text-[var(--intel-red)] font-bold tracking-wider mt-1 uppercase">
              Official Platform Redirection Hub
            </span>
          </h1>

          <p class="font-sans text-base sm:text-lg text-neutral-300 leading-relaxed max-w-3xl mb-6">
            Looking for tickets to <strong class="text-white">Avengers: Doomsday</strong>, midnight fan incursions, or Marvel blockbusters? Select your preferred verified booking platform below — including <strong class="text-white">District</strong>, <strong class="text-white">MakeMyTrip</strong>, <strong class="text-white">BookMyShow</strong>, and <strong class="text-white">Fandango</strong> — to check theater showtimes, reserve seats, and complete your purchase securely on their official apps and websites.
          </p>

          <!-- Key Information Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 font-mono text-xs">
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">DIRECT REDIRECTION</span>
              <strong class="text-white text-sm">Verified Ticketing Portals</strong>
            </div>
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">BOOKING ON SITE?</span>
              <strong class="text-amber-400 text-sm">No (External Only)</strong>
            </div>
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)] col-span-2 sm:col-span-1">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">FAN SAFETY</span>
              <strong class="text-emerald-400 text-sm">100% Anti-Scalper</strong>
            </div>
          </div>
        </div>

        <!-- 18 Dec Zero Hour Countdown Card -->
        <div class="lg:col-span-4 p-5 sm:p-6 rounded-xs bg-gradient-to-br from-[var(--intel-obsidian)] to-[var(--intel-charcoal)] border border-[var(--intel-border-strong)] relative overflow-hidden shadow-2xl">
          <div class="absolute -right-12 -top-12 w-32 h-32 bg-[var(--intel-red)]/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
            <div class="flex items-center gap-2">
              <Clock class="w-4 h-4 text-[var(--intel-red)]" />
              <span class="font-mono text-xs uppercase tracking-wider text-neutral-300 font-bold">18 DEC PREMIERE COUNTDOWN</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-xs bg-emerald-950/80 border border-emerald-500/50 text-emerald-400">
              ZERO HOUR
            </span>
          </div>

          <div id="countdown-grid" class="grid grid-cols-4 gap-2 text-center mb-4 font-mono">
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-days" class="block font-black text-2xl text-white">28</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">DAYS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-hours" class="block font-black text-2xl text-white">08</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">HOURS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-minutes" class="block font-black text-2xl text-white">35</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">MINS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-seconds" class="block font-black text-2xl text-[var(--intel-red)] animate-pulse">42</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">SECS</span>
            </div>
          </div>

          <div class="text-[11px] font-mono text-[var(--intel-muted)] flex items-center justify-between bg-black/40 p-2.5 rounded-xs border border-white/5">
            <span>Target Premiere:</span>
            <span class="text-white font-bold">Fri, Dec 18, 2026</span>
          </div>
        </div>
      </div>
    </header>

    <!-- CRITICAL TRANSPARENCY NOTICE BANNER -->
    <div class="mb-10 p-4 sm:p-5 rounded-xs bg-amber-950/20 border-l-4 border-l-amber-500 border-y border-r border-amber-500/30 flex items-start gap-3.5">
      <ShieldAlert class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
      <div class="font-sans text-xs sm:text-sm text-neutral-300 leading-relaxed">
        <strong class="text-amber-300 block font-mono text-xs uppercase tracking-wider mb-1">
          Official Booking Redirection Notice
        </strong>
        <p>
          <strong class="text-white">616 Intel is an independent entertainment journalism and Marvel leaks intelligence archive.</strong> We do not conduct ticket sales, collect payment card details, or process booking transactions on this website. When you click any of the ticketing buttons below, you will be directed straight to official external booking partners (such as <strong class="text-white">District</strong>, <strong class="text-white">MakeMyTrip</strong>, <strong class="text-white">BookMyShow</strong>, or <strong class="text-white">Fandango</strong>) where you can securely pick seats, apply theater loyalty vouchers, and purchase your movie tickets.
        </p>
      </div>
    </div>

    <!-- QUICK PLATFORM REDIRECTION SELECTOR -->
    <section class="mb-12 p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]" aria-labelledby="launcher-heading">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
        <div class="flex items-center gap-2">
          <Compass class="w-4 h-4 text-[var(--intel-red)]" />
          <h2 id="launcher-heading" class="font-display text-base font-bold text-white uppercase tracking-wider">
            Quick Platform Redirection Launcher
          </h2>
        </div>
        <span class="text-xs font-mono text-[var(--intel-muted)]">Instant External Jump</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
        <div class="md:col-span-5">
          <label for="movie-select" class="block font-mono text-xs text-[var(--intel-muted)] uppercase mb-1.5 font-bold">
            Select Movie Title
          </label>
          <select
            id="movie-select"
            class="w-full px-3 py-2.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] text-white text-xs font-mono focus:border-[var(--intel-red)] focus:outline-none"
          >
            <option value="Avengers: Doomsday">Avengers: Doomsday (Dec 18, 2026 Premiere)</option>
            <option value="Fantastic Four: First Steps">Fantastic Four: First Steps (2025)</option>
            <option value="Spider-Man: Beyond the Spider-Verse">Spider-Man: Beyond the Spider-Verse</option>
            <option value="Marvel Phase 6 Screenings">Marvel Phase 6 IMAX & Dolby Screenings</option>
          </select>
        </div>

        <div class="md:col-span-4">
          <label for="platform-select" class="block font-mono text-xs text-[var(--intel-muted)] uppercase mb-1.5 font-bold">
            Choose Ticketing Platform
          </label>
          <select
            id="platform-select"
            class="w-full px-3 py-2.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] text-white text-xs font-mono focus:border-[var(--intel-red)] focus:outline-none"
          >
            <option value="https://www.district.in">District by Zomato (district.in)</option>
            <option value="https://www.makemytrip.com">MakeMyTrip (makemytrip.com)</option>
            <option value="https://in.bookmyshow.com">BookMyShow (bookmyshow.com)</option>
            <option value="https://www.fandango.com">Fandango (fandango.com - US/Global)</option>
            <option value="https://insider.in">Paytm Insider (insider.in)</option>
            <option value="https://www.pvrcinemas.com">PVR INOX Cinemas (pvrcinemas.com)</option>
          </select>
        </div>

        <div class="md:col-span-3 pt-1 md:pt-5">
          <a
            id="launch-redirect-btn"
            href="https://www.district.in"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xs bg-[var(--intel-red)] hover:bg-[var(--intel-red-hover)] text-white font-display text-xs font-black tracking-wider uppercase transition-all shadow-[0_0_15px_rgba(225,6,0,0.4)]"
          >
            <span>Proceed to Platform</span>
            <ArrowUpRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION: OFFICIAL BOOKING PLATFORMS -->
    <div id="platforms" class="scroll-mt-24" aria-hidden="true"></div>
    <section class="mb-14 scroll-mt-24" aria-labelledby="platforms-heading">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-[var(--intel-border)]">
        <div>
          <h2 id="platforms-heading" class="font-serif text-2xl sm:text-3xl font-bold text-white">
            Verified Ticketing &amp; Booking Platforms
          </h2>
          <p class="font-sans text-xs sm:text-sm text-[var(--intel-muted)] mt-1">
            Choose an official partner platform to view theater schedules, seating charts, and reserve tickets.
          </p>
        </div>
        <span class="hidden sm:inline font-mono text-xs text-[var(--intel-muted)]">
          {platforms.length} Platforms Available
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {platforms.map((platform) => (
          <div class="p-5 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)] hover:border-[var(--intel-border-strong)] transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-start justify-between gap-2 mb-3">
                <span class:list={["px-2 py-0.5 rounded-xs font-mono text-[10px] font-bold uppercase tracking-wider border", platform.tagColor]}>
                  {platform.tag}
                </span>
                {platform.featured && (
                  <span class="px-2 py-0.5 rounded-xs bg-red-950/80 border border-red-500/40 text-red-300 font-mono text-[10px] font-bold uppercase">
                    FEATURED
                  </span>
                )}
              </div>

              <h3 class="font-display text-xl font-bold text-white uppercase tracking-wide group-hover:text-[var(--intel-red)] transition-colors flex items-center gap-2">
                <span>{platform.name}</span>
              </h3>
              <p class="text-xs font-mono text-[var(--intel-muted)] mb-3">
                {platform.subtitle}
              </p>

              <p class="text-xs text-neutral-300 font-sans leading-relaxed mb-4">
                {platform.description}
              </p>

              <ul class="space-y-1.5 mb-6 font-mono text-[11px] text-neutral-400">
                {platform.perks.map((perk) => (
                  <li class="flex items-center gap-1.5">
                    <CheckCircle2 class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={platform.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xs bg-[var(--intel-obsidian)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-[var(--intel-red)] text-white font-mono text-xs font-bold tracking-wider uppercase transition-colors"
            >
              <span>Book on {platform.name}</span>
              <ExternalLink class="w-3.5 h-3.5 text-[var(--intel-red)]" />
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION: UPCOMING MARVEL RELEASES & DIRECT JUMP -->
    <div id="pricing" class="scroll-mt-24" aria-hidden="true"></div>
    <div id="movies" class="scroll-mt-24" aria-hidden="true"></div>
    <section class="mb-14 scroll-mt-24" aria-labelledby="movies-heading">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-[var(--intel-border)]">
        <div>
          <h2 id="movies-heading" class="font-serif text-2xl sm:text-3xl font-bold text-white">
            Upcoming Blockbusters &amp; Presale Schedules
          </h2>
          <p class="font-sans text-xs sm:text-sm text-[var(--intel-muted)] mt-1">
            Browse upcoming theatrical releases and open direct booking links for your favorite platform.
          </p>
        </div>
      </div>

      <div class="space-y-6">
        {upcomingMovies.map((movie) => (
          <div class:list={[
            "p-6 rounded-xs bg-[var(--intel-charcoal)] border transition-all",
            movie.highlight ? "border-[var(--intel-red)]/60 shadow-[0_0_20px_rgba(225,6,0,0.15)]" : "border-[var(--intel-border)]"
          ]}>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
              <div class="lg:col-span-7">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded-xs bg-[var(--intel-red)] text-white font-mono text-[10px] font-bold uppercase tracking-wider">
                    {movie.status}
                  </span>
                  <span class="px-2 py-0.5 rounded-xs bg-neutral-800 text-neutral-300 font-mono text-[10px]">
                    {movie.format}
                  </span>
                </div>

                <h3 class="font-serif text-2xl font-bold text-white mb-2">
                  {movie.title}
                </h3>

                <p class="font-sans text-xs sm:text-sm text-neutral-300 leading-relaxed mb-3">
                  {movie.synopsis}
                </p>

                <div class="flex items-center gap-2 font-mono text-xs text-emerald-400">
                  <Calendar class="w-3.5 h-3.5" />
                  <span>Theatrical Release Date: <strong>{movie.releaseDate}</strong></span>
                </div>
              </div>

              <div class="lg:col-span-5 bg-[var(--intel-obsidian)] p-4 rounded-xs border border-[var(--intel-border-subtle)]">
                <span class="block font-mono text-[11px] text-[var(--intel-muted)] uppercase mb-3 font-bold">
                  Direct Booking Redirection:
                </span>
                
                <div class="grid grid-cols-2 gap-2 font-mono text-xs">
                  <a
                    href="https://www.district.in"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-amber-500 text-white font-bold flex items-center justify-between text-[11px] transition-colors"
                  >
                    <span>District</span>
                    <ArrowUpRight class="w-3 h-3 text-amber-400" />
                  </a>

                  <a
                    href="https://www.makemytrip.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-cyan-500 text-white font-bold flex items-center justify-between text-[11px] transition-colors"
                  >
                    <span>MakeMyTrip</span>
                    <ArrowUpRight class="w-3 h-3 text-cyan-400" />
                  </a>

                  <a
                    href="https://in.bookmyshow.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-rose-500 text-white font-bold flex items-center justify-between text-[11px] transition-colors"
                  >
                    <span>BookMyShow</span>
                    <ArrowUpRight class="w-3 h-3 text-rose-400" />
                  </a>

                  <a
                    href="https://www.fandango.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-2 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-purple-500 text-white font-bold flex items-center justify-between text-[11px] transition-colors"
                  >
                    <span>Fandango</span>
                    <ArrowUpRight class="w-3 h-3 text-purple-400" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION: TICKET BUYER SAFETY & FAQ -->
    <div id="theaters" class="scroll-mt-24" aria-hidden="true"></div>
    <div id="faq" class="scroll-mt-24" aria-hidden="true"></div>
    <section id="safety" class="pt-8 border-t border-[var(--intel-border)] scroll-mt-24" aria-labelledby="safety-heading">
      <div class="mb-6">
        <h2 id="safety-heading" class="font-serif text-2xl font-bold text-white mb-2">
          Fan Safety &amp; Official Booking Checkpoints
        </h2>
        <p class="font-sans text-xs sm:text-sm text-[var(--intel-muted)]">
          Guidelines for safely securing your Avengers: Doomsday and Marvel opening weekend passes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-sans text-xs">
        <div class="p-4 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
          <div class="flex items-center gap-2 font-mono font-bold text-white uppercase mb-2">
            <ShieldCheck class="w-4 h-4 text-emerald-400" />
            <span>Anti-Scalper Protection</span>
          </div>
          <p class="text-neutral-300 leading-relaxed">
            Never purchase movie tickets or QR entry codes from unverified social media resellers or unauthorized forums. Always complete transactions directly on verified platforms like District, MakeMyTrip, or BookMyShow.
          </p>
        </div>

        <div class="p-4 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
          <div class="flex items-center gap-2 font-mono font-bold text-white uppercase mb-2">
            <Building2 class="w-4 h-4 text-[var(--intel-red)]" />
            <span>IMAX 70mm Formats</span>
          </div>
          <p class="text-neutral-300 leading-relaxed">
            Avengers: Doomsday features expanded aspect ratios designed specifically for IMAX 70mm and dual 4K laser soundstages. Check platform auditorium labels to ensure full 1.43:1 or 1.90:1 presentation.
          </p>
        </div>

        <div class="p-4 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
          <div class="flex items-center gap-2 font-mono font-bold text-white uppercase mb-2">
            <Info class="w-4 h-4 text-cyan-400" />
            <span>Customer Service &amp; Refunds</span>
          </div>
          <p class="text-neutral-300 leading-relaxed">
            Because payments and reservations are processed by the respective ticketing vendors, any refund requests, seat changes, or booking queries should be submitted directly to District, MakeMyTrip, BookMyShow, or your local cinema box office.
          </p>
        </div>
      </div>
    </section>

  </div>

  <!-- Interactive Script for Quick Launcher and Live Countdown -->
  <script is:inline>
    (function initTicketRedirectHub() {
      // 1. COUNTDOWN TIMER TO 18 DEC 2026
      const targetDate = new Date('2026-12-18T00:01:00Z').getTime();

      function updateCountdown() {
        const now = new Date().getTime();
        const difference = targetDate - now;

        if (difference > 0) {
          const days = Math.floor(difference / (1000 * 60 * 60 * 24));
          const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((difference % (1000 * 60)) / 1000);

          const daysEl = document.getElementById('countdown-days');
          const hoursEl = document.getElementById('countdown-hours');
          const minsEl = document.getElementById('countdown-minutes');
          const secsEl = document.getElementById('countdown-seconds');

          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
          if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
        }
      }
      updateCountdown();
      setInterval(updateCountdown, 1000);

      // 2. QUICK LAUNCHER SELECTOR DYNAMICS
      const platformSelect = document.getElementById('platform-select');
      const launchBtn = document.getElementById('launch-redirect-btn');

      if (platformSelect && launchBtn) {
        platformSelect.addEventListener('change', function() {
          const chosenUrl = this.value;
          launchBtn.setAttribute('href', chosenUrl);
        });
      }
    })();
  </script>
