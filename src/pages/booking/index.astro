  <!-- Client-Side Booking Logic Script -->
  <script is:inline>
    (function initBookingApp() {
      // 1. COUNTDOWN TO 18 DEC 2026 ZERO HOUR
      const targetDate = new Date('2026-12-18T00:01:00Z').getTime();

      function updateCountdown() {
        const now = new Date().getTime();
        const difference = targetDate - now;

        if (difference > 0) {
          const days = Math.floor(difference / (1000 * 60 * 60 * 24));
          const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((difference % (1000 * 60)) / 1000);

          const daysEl = document.getElementById('countdown-days');
          const hoursEl = document.getElementById('countdown-hours');
          const minsEl = document.getElementById('countdown-minutes');
          const secsEl = document.getElementById('countdown-seconds');

          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
          if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
        }
      }
      updateCountdown();
      setInterval(updateCountdown, 1000);

      // 2. STATE MANAGEMENT
      const state = {
        formatName: 'IMAX 70mm Laser',
        formatPrice: 28.50,
        theaterName: 'AMC Lincoln Square IMAX 70mm',
        theaterCity: 'New York, NY',
        showtime: '10:15 PM EST',
        selectedSeats: ['E6', 'E7'],
        addons: [
          { id: 'addon-metal-pass', name: 'Collector Metallic Foil Ticket & Lanyard', price: 9.99 }
        ],
        promoDiscountPercent: 0,
        promoFlatDiscount: 0,
        promoCodeApplied: '',
        attendeeName: 'Victor Richards',
        attendeeEmail: 'victor@latveria.com',
        bookingRef: 'DOOM-20261218-8492'
      };

      // 3. GENERATE INTERACTIVE AUDITORIUM SEAT MAP
      const seatGrid = document.getElementById('theater-seat-grid');
      const rows = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
      const cols = 12;

      // Realistic pre-reserved seats for scarcity effect
      const reservedSeats = new Set([
        'A1', 'A2', 'A11', 'A12',
        'B3', 'B4', 'B5', 'B8', 'B9',
        'C2', 'C6', 'C7', 'C11',
        'D1', 'D2', 'D11', 'D12',
        'F4', 'F5', 'F6', 'F7', 'F8',
        'G3', 'G10',
        'H1', 'H2', 'H11', 'H12'
      ]);

      function isVipSeat(row, col) {
        return (row === 'D' || row === 'E') && col >= 4 && col <= 9;
      }

      function renderSeatGrid() {
        if (!seatGrid) return;
        seatGrid.innerHTML = '';

        rows.forEach(function(row) {
          const rowDiv = document.createElement('div');
          rowDiv.className = 'flex items-center justify-center gap-1.5 sm:gap-2';

          // Row Label Left
          const labelLeft = document.createElement('span');
          labelLeft.className = 'w-4 text-center font-mono text-[11px] text-[var(--intel-muted)] font-bold';
          labelLeft.textContent = row;
          rowDiv.appendChild(labelLeft);

          // Seats 1 to 12
          for (let col = 1; col <= cols; col++) {
            // Aisle divider in center
            if (col === 7) {
              const aisle = document.createElement('div');
              aisle.className = 'w-4 sm:w-6';
              rowDiv.appendChild(aisle);
            }

            const seatId = row + col;
            const isReserved = reservedSeats.has(seatId);
            const isSelected = state.selectedSeats.includes(seatId);
            const isVip = isVipSeat(row, col);

            const seatBtn = document.createElement('button');
            seatBtn.type = 'button';
            seatBtn.setAttribute('data-seat-id', seatId);
            seatBtn.setAttribute('aria-label', `Row ${row} Seat ${col}${isVip ? ' VIP Prime' : ''}${isReserved ? ' (Reserved)' : ''}`);
            seatBtn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');

            let seatClasses = 'w-6 h-6 sm:w-7 sm:h-7 rounded-xs font-mono text-[10px] font-bold flex items-center justify-center transition-all duration-150 ';

            if (isReserved) {
              seatClasses += 'bg-neutral-900 border border-neutral-800 text-neutral-600 cursor-not-allowed opacity-40';
              seatBtn.disabled = true;
            } else if (isSelected) {
              seatClasses += 'bg-[var(--intel-red)] border border-red-400 text-white shadow-[0_0_10px_rgba(225,6,0,0.8)] scale-105';
            } else if (isVip) {
              seatClasses += 'bg-amber-950/40 border border-amber-500/70 text-amber-300 hover:bg-amber-900/60 hover:scale-105';
            } else {
              seatClasses += 'bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-300 hover:border-[var(--intel-red)] hover:text-white hover:scale-105';
            }

            seatBtn.className = seatClasses;
            seatBtn.textContent = String(col);

            seatBtn.addEventListener('click', function() {
              toggleSeat(seatId);
            });

            rowDiv.appendChild(seatBtn);
          }

          // Row Label Right
          const labelRight = document.createElement('span');
          labelRight.className = 'w-4 text-center font-mono text-[11px] text-[var(--intel-muted)] font-bold';
          labelRight.textContent = row;
          rowDiv.appendChild(labelRight);

          seatGrid.appendChild(rowDiv);
        });
      }

      function toggleSeat(seatId) {
        const index = state.selectedSeats.indexOf(seatId);
        if (index > -1) {
          // Deselect (ensure at least 1 remains or allow empty with message)
          if (state.selectedSeats.length === 1) {
            alert('At least one seat must be selected to proceed with booking.');
            return;
          }
          state.selectedSeats.splice(index, 1);
        } else {
          // Max 6 seats limit
          if (state.selectedSeats.length >= 6) {
            alert('Maximum 6 seats per transaction for premiere night allocation.');
            return;
          }
          state.selectedSeats.push(seatId);
        }
        renderSeatGrid();
        updateSummary();
      }

      // 4. UPDATE LIVE PRICE & ORDER SUMMARY
      function updateSummary() {
        const seatCount = state.selectedSeats.length;
        const seatCountEl = document.getElementById('selected-seat-count');
        if (seatCountEl) seatCountEl.textContent = String(seatCount);

        // Update allocated badges
        const badgeList = document.getElementById('selected-seats-badge-list');
        if (badgeList) {
          badgeList.innerHTML = '';
          state.selectedSeats.forEach(function(s) {
            const span = document.createElement('span');
            span.className = 'seat-badge px-2.5 py-1 rounded-xs bg-[var(--intel-red)]/20 border border-[var(--intel-red)] text-white text-xs font-mono font-bold flex items-center gap-1.5';
            span.innerHTML = `ROW ${s.charAt(0)} • SEAT ${s.slice(1)} <button type="button" class="text-neutral-400 hover:text-white" aria-label="Remove ${s}">✕</button>`;
            span.querySelector('button')?.addEventListener('click', function(e) {
              e.stopPropagation();
              toggleSeat(s);
            });
            badgeList.appendChild(span);
          });
        }

        // Summary details
        const summaryShowtime = document.getElementById('summary-showtime');
        if (summaryShowtime) summaryShowtime.textContent = state.showtime;

        const summaryFormat = document.getElementById('summary-format');
        if (summaryFormat) summaryFormat.textContent = state.formatName;

        const summaryTheater = document.getElementById('summary-theater');
        if (summaryTheater) summaryTheater.textContent = state.theaterName;

        const summarySeats = document.getElementById('summary-seats');
        if (summarySeats) summarySeats.textContent = `${state.selectedSeats.join(', ')} (${seatCount} Tickets)`;

        // Calculations
        const ticketsSubtotal = seatCount * state.formatPrice;
        const bookingFee = 2.50;
        
        let addonsSubtotal = 0;
        state.addons.forEach(function(a) {
          addonsSubtotal += a.price;
        });

        const ticketLine = document.getElementById('summary-ticket-line');
        if (ticketLine) ticketLine.textContent = `Tickets (${seatCount} × $${state.formatPrice.toFixed(2)})`;

        const ticketTotal = document.getElementById('summary-ticket-total');
        if (ticketTotal) ticketTotal.textContent = `$${ticketsSubtotal.toFixed(2)}`;

        const addonRow = document.getElementById('summary-addon-row');
        const addonTotal = document.getElementById('summary-addon-total');
        if (addonRow && addonTotal) {
          if (addonsSubtotal > 0) {
            addonRow.classList.remove('hidden');
            addonTotal.textContent = `$${addonsSubtotal.toFixed(2)}`;
          } else {
            addonRow.classList.add('hidden');
          }
        }

        // Promo calculations
        let discount = 0;
        if (state.promoDiscountPercent > 0) {
          discount = (ticketsSubtotal * state.promoDiscountPercent) / 100;
        } else if (state.promoFlatDiscount > 0) {
          discount = Math.min(state.promoFlatDiscount, ticketsSubtotal);
        }

        const discountRow = document.getElementById('summary-discount-row');
        const discountLabel = document.getElementById('summary-discount-label');
        const discountAmount = document.getElementById('summary-discount-amount');
        if (discountRow && discountLabel && discountAmount) {
          if (discount > 0) {
            discountRow.classList.remove('hidden');
            discountRow.classList.add('flex');
            discountLabel.textContent = `Promo Code (${state.promoCodeApplied})`;
            discountAmount.textContent = `-$${discount.toFixed(2)}`;
          } else {
            discountRow.classList.add('hidden');
            discountRow.classList.remove('flex');
          }
        }

        const grandTotal = Math.max(0, (ticketsSubtotal + bookingFee + addonsSubtotal - discount));
        const grandTotalEl = document.getElementById('summary-grand-total');
        if (grandTotalEl) grandTotalEl.textContent = `$${grandTotal.toFixed(2)}`;
      }

      // 5. EVENT LISTENERS: FORMAT SELECTION
      document.querySelectorAll('input[name="experience-format"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
          state.formatPrice = parseFloat(this.getAttribute('data-price') || '28.50');
          state.formatName = this.getAttribute('data-name') || 'IMAX 70mm Laser';

          // Update card active styles
          document.querySelectorAll('.format-card').forEach(function(card) {
            card.classList.remove('border-[var(--intel-red)]', 'border-2');
            card.classList.add('border-[var(--intel-border)]', 'border');
          });
          const parent = radio.closest('.format-card');
          if (parent) {
            parent.classList.remove('border-[var(--intel-border)]', 'border');
            parent.classList.add('border-[var(--intel-red)]', 'border-2');
          }

          updateSummary();
        });
      });

      // 6. EVENT LISTENERS: THEATER LOCATION
      document.querySelectorAll('input[name="theater-location"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
          state.theaterName = this.getAttribute('data-name') || '';
          state.theaterCity = this.getAttribute('data-city') || '';

          document.querySelectorAll('.theater-card').forEach(function(card) {
            card.classList.remove('border-[var(--intel-red)]', 'border-2');
            card.classList.add('border-[var(--intel-border)]', 'border');
          });
          const parent = radio.closest('.theater-card');
          if (parent) {
            parent.classList.remove('border-[var(--intel-border)]', 'border');
            parent.classList.add('border-[var(--intel-red)]', 'border-2');
          }

          updateSummary();
        });
      });

      // 7. EVENT LISTENERS: SHOWTIME SELECTION
      document.querySelectorAll('input[name="showtime-slot"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
          state.showtime = this.getAttribute('data-time') || '10:15 PM EST';

          document.querySelectorAll('.showtime-card').forEach(function(card) {
            card.classList.remove('border-[var(--intel-red)]', 'border-2');
            card.classList.add('border-[var(--intel-border)]', 'border');
          });
          const parent = radio.closest('.showtime-card');
          if (parent) {
            parent.classList.remove('border-[var(--intel-border)]', 'border');
            parent.classList.add('border-[var(--intel-red)]', 'border-2');
          }

          updateSummary();
        });
      });

      // 8. EVENT LISTENERS: ADD-ONS
      document.querySelectorAll('.addon-checkbox').forEach(function(checkbox) {
        checkbox.addEventListener('change', function() {
          const id = this.id;
          const name = this.getAttribute('data-name') || '';
          const price = parseFloat(this.getAttribute('data-price') || '0');

          if (this.checked) {
            state.addons.push({ id, name, price });
          } else {
            state.addons = state.addons.filter(function(a) { return a.id !== id; });
          }
          updateSummary();
        });
      });

      // 9. PROMO CODE ENGINE
      const applyBtn = document.getElementById('apply-promo-btn');
      const promoInput = document.getElementById('promo-input');
      const promoMsg = document.getElementById('promo-message');

      if (applyBtn && promoInput && promoMsg) {
        applyBtn.addEventListener('click', function() {
          const code = promoInput.value.trim().toUpperCase();
          if (!code) return;

          if (code === 'DOOMSDAY616') {
            state.promoDiscountPercent = 20;
            state.promoFlatDiscount = 0;
            state.promoCodeApplied = 'DOOMSDAY616 (20% OFF)';
            promoMsg.className = 'text-[11px] font-mono mt-1.5 text-emerald-400 block';
            promoMsg.textContent = '✓ 20% Multiverse fan discount applied to tickets!';
          } else if (code === 'LATVERIA') {
            state.promoDiscountPercent = 0;
            state.promoFlatDiscount = 10.00;
            state.promoCodeApplied = 'LATVERIA ($10 OFF)';
            promoMsg.className = 'text-[11px] font-mono mt-1.5 text-emerald-400 block';
            promoMsg.textContent = '✓ $10 Latverian monarch treasury voucher applied!';
          } else if (code === 'RDJDOOM') {
            state.promoDiscountPercent = 15;
            state.promoFlatDiscount = 0;
            state.promoCodeApplied = 'RDJDOOM (15% OFF)';
            promoMsg.className = 'text-[11px] font-mono mt-1.5 text-emerald-400 block';
            promoMsg.textContent = '✓ 15% Doctor Doom cast insider discount applied!';
          } else {
            state.promoDiscountPercent = 0;
            state.promoFlatDiscount = 0;
            state.promoCodeApplied = '';
            promoMsg.className = 'text-[11px] font-mono mt-1.5 text-red-400 block';
            promoMsg.textContent = '✕ Invalid voucher code. Try DOOMSDAY616 or LATVERIA.';
          }
          updateSummary();
        });
      }

      // 10. CHECKOUT SUBMISSION & MODAL CONFIRMATION
      const checkoutForm = document.getElementById('checkout-form');
      const modal = document.getElementById('confirmation-modal');
      const closeModalX = document.getElementById('close-modal-x');
      const doneBtn = document.getElementById('done-ticket-btn');
      const printBtn = document.getElementById('print-ticket-btn');
      const copyCodeBtn = document.getElementById('copy-code-btn');
      const copyBtnText = document.getElementById('copy-btn-text');

      if (checkoutForm && modal) {
        checkoutForm.addEventListener('submit', function(e) {
          e.preventDefault();

          if (state.selectedSeats.length === 0) {
            alert('Please select at least 1 seat before checking out.');
            return;
          }

          const nameInput = document.getElementById('attendee-name');
          const emailInput = document.getElementById('attendee-email');
          const attendeeName = nameInput ? nameInput.value.trim() : 'Victor Richards';
          const attendeeEmail = emailInput ? emailInput.value.trim() : 'victor@latveria.com';

          // Generate random reference code
          const randomNum = Math.floor(1000 + Math.random() * 9000);
          state.bookingRef = `DOOM-20261218-${randomNum}`;

          // Populate Modal with state
          const refEl = document.getElementById('ticket-ref-code');
          if (refEl) refEl.textContent = state.bookingRef;

          const timeEl = document.getElementById('ticket-modal-time');
          if (timeEl) timeEl.textContent = state.showtime;

          const formatEl = document.getElementById('ticket-modal-format');
          if (formatEl) formatEl.textContent = state.formatName.toUpperCase();

          const venueEl = document.getElementById('ticket-modal-venue');
          if (venueEl) venueEl.textContent = `${state.theaterName}, ${state.theaterCity}`;

          const seatsEl = document.getElementById('ticket-modal-seats');
          if (seatsEl) seatsEl.textContent = `${state.selectedSeats.map(s => `ROW ${s.charAt(0)} • SEAT ${s.slice(1)}`).join(', ')}`;

          const nameEl = document.getElementById('ticket-modal-name');
          if (nameEl) nameEl.textContent = attendeeName;

          const grandTotalEl = document.getElementById('summary-grand-total');
          const modalPriceEl = document.getElementById('ticket-modal-price');
          if (modalPriceEl && grandTotalEl) modalPriceEl.textContent = grandTotalEl.textContent;

          // Open Modal
          modal.classList.remove('invisible', 'opacity-0');
          modal.classList.add('visible', 'opacity-100');
          document.body.style.overflow = 'hidden';
        });

        function closeModal() {
          modal.classList.remove('visible', 'opacity-100');
          modal.classList.add('invisible', 'opacity-0');
          document.body.style.overflow = '';
        }

        if (closeModalX) closeModalX.addEventListener('click', closeModal);
        if (doneBtn) doneBtn.addEventListener('click', closeModal);

        if (printBtn) {
          printBtn.addEventListener('click', function() {
            window.print();
          });
        }

        if (copyCodeBtn && copyBtnText) {
          copyCodeBtn.addEventListener('click', function() {
            navigator.clipboard.writeText(state.bookingRef).then(function() {
              copyBtnText.textContent = 'Copied!';
              setTimeout(function() {
                copyBtnText.textContent = 'Copy Code';
              }, 2000);
            });
          });
        }
      }

      // Initialize
      renderSeatGrid();
      updateSummary();
    })();
  </script>

  <!-- Dedicated Print Stylesheet for Pristine Cinema Pass Printing -->
  <style is:inline>
    @media print {
      body * {
        visibility: hidden !important;
      }
      #confirmation-modal,
      #confirmation-modal * {
        visibility: visible !important;
      }
      #confirmation-modal {
        position: absolute !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        height: auto !important;
        background: #ffffff !important;
        padding: 0 !important;
      }
      #confirmation-modal > div {
        max-width: 100% !important;
        border: 2px solid #000000 !important;
        background: #ffffff !important;
        color: #000000 !important;
        box-shadow: none !important;
      }
      #printable-ticket {
        background: #ffffff !important;
        color: #000000 !important;
        border: 1px solid #333333 !important;
      }
      #printable-ticket * {
        color: #000000 !important;
      }
      #close-modal-x,
      #print-ticket-btn,
      #copy-code-btn,
      #done-ticket-btn {
        display: none !important;
      }
    }
  </style>
</BaseLayout>
