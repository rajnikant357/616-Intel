---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { 
  Ticket, 
  Calendar, 
  Clock, 
  MapPin, 
  Film, 
  Sparkles, 
  ShieldCheck, 
  ShieldAlert, 
  Check, 
  CreditCard, 
  Printer, 
  Download, 
  Copy, 
  ArrowRight, 
  Zap, 
  Flame, 
  Eye, 
  Info, 
  Lock,
  ChevronRight,
  Armchair
} from '@lucide/astro';

const siteUrl = Astro.site?.origin || 'https://616intel.prometrion.com';

// Structured Data for Google Event & Movie Ticket Pre-Order
const bookingSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ScreeningEvent',
    name: 'Avengers: Doomsday — Official Opening Night Premiere & Midnight Incursions',
    description: 'Exclusive worldwide opening night and midnight fan incursion screenings for Marvel Studios Avengers: Doomsday on Friday, December 18, 2026. Featuring IMAX 70mm, Dolby Cinema, and 4DX immersive presentations.',
    startDate: '2026-12-18T17:00:00-05:00',
    endDate: '2026-12-19T03:00:00-05:00',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'MovieTheater',
      name: 'AMC Lincoln Square IMAX 70mm',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1998 Broadway',
        addressLocality: 'New York',
        addressRegion: 'NY',
        postalCode: '10023',
        addressCountry: 'US',
      },
    },
    workPresented: {
      '@type': 'Movie',
      name: 'Avengers: Doomsday',
      director: [
        { '@type': 'Person', name: 'Anthony Russo' },
        { '@type': 'Person', name: 'Joe Russo' },
      ],
      actor: [
        { '@type': 'Person', name: 'Robert Downey Jr.' },
        { '@type': 'Person', name: 'Pedro Pascal' },
        { '@type': 'Person', name: 'Tom Holland' },
        { '@type': 'Person', name: 'Hugh Jackman' },
      ],
      duration: 'PT182M',
    },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: '16.50',
      highPrice: '28.50',
      offerCount: '1200',
      availability: 'https://schema.org/InStock',
      validFrom: '2026-11-01',
      url: `${siteUrl}/booking`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Avengers: Doomsday', item: `${siteUrl}/articles/avengers-doomsday` },
      { '@type': 'ListItem', position: 3, name: '18 Dec Booking Wire', item: `${siteUrl}/booking` },
    ],
  },
];
---

<BaseLayout
  title="Avengers: Doomsday 18 Dec Tickets & Premiere Booking | 616 Intel"
  description="Book official opening night and midnight fan screening tickets for Avengers: Doomsday on December 18, 2026. Reserve IMAX 70mm, Dolby Cinema, and collector perk passes."
  keywords="avengers doomsday tickets, doomsday 18 dec booking, avengers doomsday december 18, doctor doom premiere tickets, imax 70mm avengers doomsday, midnight incursion screening, marvel phase 6 booking"
  jsonLd={bookingSchema}
>
  <div class="container-editorial py-6 md:py-10 max-w-6xl mx-auto print:hidden">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Avengers: Doomsday', href: '/articles/avengers-doomsday' },
        { label: '18 Dec Premiere Booking' },
      ]}
    />

    <!-- Dossier Alert Bar -->
    <div class="mb-6 p-3 sm:p-4 rounded-xs bg-[var(--intel-charcoal)] border-l-4 border-l-[var(--intel-red)] border-y border-r border-[var(--intel-border)] flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase">
          TICKET DISPATCH PROTOCOL ACTIVE
        </span>
        <span class="text-xs text-[var(--intel-muted)] font-mono hidden sm:inline">•</span>
        <span class="text-xs font-mono text-[var(--intel-muted)] hidden sm:inline">
          TARGET DATE: FRIDAY, 18 DECEMBER 2026
        </span>
      </div>
      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="px-2 py-0.5 rounded-xs bg-red-950/80 border border-red-500/40 text-red-300 font-bold">
          94% RESERVED
        </span>
        <span class="text-[var(--intel-dim)] text-[11px] hidden md:inline">LIVE THEATER ALLOCATION</span>
      </div>
    </div>

    <!-- Hero Header Block -->
    <header class="mb-10 pb-8 border-b border-[var(--intel-border)]">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="px-2.5 py-1 rounded-xs bg-[var(--intel-red)] text-white font-mono text-xs font-bold tracking-widest uppercase shadow-[0_0_12px_rgba(225,6,0,0.4)]">
          WORLDWIDE PREMIERE
        </span>
        <span class="px-2.5 py-1 rounded-xs bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 font-mono text-xs font-bold tracking-wider uppercase">
          DECEMBER 18, 2026
        </span>
        <span class="px-2.5 py-1 rounded-xs bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-300 font-mono text-xs font-medium">
          CLASSIFICATION: PHASE 6 CLIMAX
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8">
          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.05] mb-4">
            Avengers: Doomsday
            <span class="block text-2xl sm:text-3xl lg:text-4xl font-display text-[var(--intel-red)] font-bold tracking-wider mt-1 uppercase">
              18 Dec Opening Night &amp; Midnight Incursion Booking
            </span>
          </h1>

          <p class="font-sans text-base sm:text-lg text-neutral-300 leading-relaxed max-w-3xl mb-6">
            Witness the cosmic collision of the Marvel Multiverse as <strong class="text-white">Robert Downey Jr.</strong> ascends as Doctor Victor von Doom. Lock in your reserved seats for the historic worldwide premiere and midnight fan screenings on <span class="text-white font-semibold underline decoration-[var(--intel-red)] decoration-2">Friday, 18 December 2026</span> across flagship IMAX 70mm, Dolby Cinema, and 4DX soundstages.
          </p>

          <!-- Production Metadata Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">RUNTIME</span>
              <strong class="text-white text-sm">182 MIN (3H 02M)</strong>
            </div>
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">DIRECTORS</span>
              <strong class="text-white text-sm">RUSSO BROTHERS</strong>
            </div>
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">SOUND MASTER</span>
              <strong class="text-white text-sm">DOLBY ATMOS / IMAX</strong>
            </div>
            <div class="p-3 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]">
              <span class="text-[var(--intel-muted)] block text-[10px] uppercase">PERK INCLUDED</span>
              <strong class="text-amber-400 text-sm">FOIL TICKET PASS</strong>
            </div>
          </div>
        </div>

        <!-- Live Countdown Module -->
        <div class="lg:col-span-4 p-5 sm:p-6 rounded-xs bg-gradient-to-br from-[var(--intel-obsidian)] to-[var(--intel-charcoal)] border border-[var(--intel-border-strong)] relative overflow-hidden shadow-2xl">
          <div class="absolute -right-12 -top-12 w-32 h-32 bg-[var(--intel-red)]/10 rounded-full blur-2xl pointer-events-none"></div>
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
            <div class="flex items-center gap-2">
              <Clock class="w-4 h-4 text-[var(--intel-red)]" />
              <span class="font-mono text-xs uppercase tracking-wider text-neutral-300 font-bold">18 DEC ZERO HOUR</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-xs bg-emerald-950/80 border border-emerald-500/50 text-emerald-400">
              COUNTDOWN
            </span>
          </div>

          <div id="countdown-grid" class="grid grid-cols-4 gap-2 text-center mb-4 font-mono">
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-days" class="block font-black text-2xl text-white">28</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">DAYS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-hours" class="block font-black text-2xl text-white">08</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">HOURS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-minutes" class="block font-black text-2xl text-white">35</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">MINS</span>
            </div>
            <div class="p-2 rounded-xs bg-[var(--intel-void)] border border-[var(--intel-border-subtle)]">
              <span id="countdown-seconds" class="block font-black text-2xl text-[var(--intel-red)] animate-pulse">42</span>
              <span class="text-[9px] uppercase tracking-wider text-[var(--intel-muted)]">SECS</span>
            </div>
          </div>

          <div class="text-[11px] font-mono text-[var(--intel-muted)] flex items-center justify-between bg-black/40 p-2.5 rounded-xs border border-white/5">
            <span>Theatrical Lock:</span>
            <span class="text-white font-bold">Fri, Dec 18, 2026 • 00:01 EST</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Booking Engine Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Interactive Booking Wizard Steps -->
      <div class="lg:col-span-8 space-y-8">
        
        <!-- STEP 1: SELECT FORMAT -->
        <section class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]" aria-labelledby="format-heading">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-xs bg-[var(--intel-red)] text-white text-xs font-mono font-bold flex items-center justify-center">1</span>
              <h2 id="format-heading" class="font-display text-lg font-bold text-white tracking-wide uppercase">
                Choose Projection &amp; Sound Format
              </h2>
            </div>
            <span class="text-xs font-mono text-[var(--intel-muted)]">Step 1 of 5</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Projection Formats">
            <!-- Format: IMAX 70mm -->
            <label class="format-card relative p-4 rounded-xs bg-[var(--intel-obsidian)] border-2 border-[var(--intel-red)] cursor-pointer transition-all hover:bg-[var(--intel-elevated)] select-none">
              <input type="radio" name="experience-format" value="imax-70mm" data-price="28.50" data-name="IMAX 70mm Laser" class="sr-only" checked />
              <div class="flex items-start justify-between mb-2">
                <div>
                  <span class="px-2 py-0.5 rounded-xs bg-[var(--intel-red)]/20 border border-[var(--intel-red)] text-[var(--intel-red)] font-mono text-[10px] font-bold uppercase tracking-wider inline-block mb-1">
                    DIRECTOR RECOMMENDED
                  </span>
                  <h3 class="font-display text-base font-bold text-white uppercase tracking-wider">IMAX 70mm Laser</h3>
                </div>
                <span class="font-mono text-lg font-black text-white">$28.50</span>
              </div>
              <p class="text-xs text-neutral-300 font-sans mb-3">
                Full 1.43:1 Battleworld aspect ratio on a 75-foot screen. Includes exclusive physical metallic foil ticket pass.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-emerald-400">
                <Check class="w-3.5 h-3.5" />
                <span>Dual 4K Laser + 12-Channel Sound</span>
              </div>
            </label>

            <!-- Format: Dolby Cinema -->
            <label class="format-card relative p-4 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer transition-all hover:bg-[var(--intel-elevated)] select-none">
              <input type="radio" name="experience-format" value="dolby-cinema" data-price="24.00" data-name="Dolby Cinema Atmos" class="sr-only" />
              <div class="flex items-start justify-between mb-2">
                <div>
                  <span class="px-2 py-0.5 rounded-xs bg-cyan-950/80 border border-cyan-500/40 text-cyan-300 font-mono text-[10px] font-bold uppercase tracking-wider inline-block mb-1">
                    AUDIO OBSESSION
                  </span>
                  <h3 class="font-display text-base font-bold text-white uppercase tracking-wider">Dolby Cinema</h3>
                </div>
                <span class="font-mono text-lg font-black text-white">$24.00</span>
              </div>
              <p class="text-xs text-neutral-300 font-sans mb-3">
                Dolby Vision dual-laser HDR paired with 128-speaker spatial Dolby Atmos and haptic rumble recliners.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-neutral-400">
                <Check class="w-3.5 h-3.5" />
                <span>128 Spatial Objects + Power Recliners</span>
              </div>
            </label>

            <!-- Format: 4DX Motion -->
            <label class="format-card relative p-4 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer transition-all hover:bg-[var(--intel-elevated)] select-none">
              <input type="radio" name="experience-format" value="4dx-motion" data-price="26.00" data-name="4DX Immersive Motion" class="sr-only" />
              <div class="flex items-start justify-between mb-2">
                <div>
                  <span class="px-2 py-0.5 rounded-xs bg-purple-950/80 border border-purple-500/40 text-purple-300 font-mono text-[10px] font-bold uppercase tracking-wider inline-block mb-1">
                    INCURSION SIMULATION
                  </span>
                  <h3 class="font-display text-base font-bold text-white uppercase tracking-wider">4DX Multiverse</h3>
                </div>
                <span class="font-mono text-lg font-black text-white">$26.00</span>
              </div>
              <p class="text-xs text-neutral-300 font-sans mb-3">
                Synchronized heave, pitch, and roll motions with lightning flashes, wind storms, and ozone mist during incursion battle sequences.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-neutral-400">
                <Check class="w-3.5 h-3.5" />
                <span>Synchronized Motion + Atmospheric FX</span>
              </div>
            </label>

            <!-- Format: Standard Digital 4K -->
            <label class="format-card relative p-4 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer transition-all hover:bg-[var(--intel-elevated)] select-none">
              <input type="radio" name="experience-format" value="standard-4k" data-price="16.50" data-name="Standard Digital 4K" class="sr-only" />
              <div class="flex items-start justify-between mb-2">
                <div>
                  <span class="px-2 py-0.5 rounded-xs bg-neutral-800 border border-neutral-700 text-neutral-300 font-mono text-[10px] font-bold uppercase tracking-wider inline-block mb-1">
                    CLASSIC THEATER
                  </span>
                  <h3 class="font-display text-base font-bold text-white uppercase tracking-wider">Digital 4K Laser</h3>
                </div>
                <span class="font-mono text-lg font-black text-white">$16.50</span>
              </div>
              <p class="text-xs text-neutral-300 font-sans mb-3">
                Crisp 4K digital theatrical master with pristine 7.1 surround sound and premium stadium seating.
              </p>
              <div class="flex items-center gap-2 text-[10px] font-mono text-neutral-400">
                <Check class="w-3.5 h-3.5" />
                <span>4K Laser Barco + 7.1 Surround</span>
              </div>
            </label>
          </div>
        </section>

        <!-- STEP 2: SELECT CINEMA & CITY -->
        <section class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]" aria-labelledby="theater-heading">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-xs bg-[var(--intel-red)] text-white text-xs font-mono font-bold flex items-center justify-center">2</span>
              <h2 id="theater-heading" class="font-display text-lg font-bold text-white tracking-wide uppercase">
                Select Premiere Flagship Theater
              </h2>
            </div>
            <span class="text-xs font-mono text-[var(--intel-muted)]">Step 2 of 5</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" role="radiogroup" aria-label="Flagship Theaters">
            <!-- New York -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border-2 border-[var(--intel-red)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="nyc-lincoln" data-name="AMC Lincoln Square IMAX 70mm" data-city="New York, NY" class="sr-only" checked />
              <div class="flex items-center gap-1.5 text-xs font-mono text-[var(--intel-red)] font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>NEW YORK, NY</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">AMC Lincoln Square IMAX</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">Screen 1 • 75' x 100' Dual Laser</p>
            </label>

            <!-- Los Angeles -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="la-chinese" data-name="TCL Chinese Theatre IMAX" data-city="Los Angeles, CA" class="sr-only" />
              <div class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>LOS ANGELES, CA</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">TCL Chinese Theatre IMAX</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">Hollywood Blvd • Historic Screen</p>
            </label>

            <!-- London -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="london-bfi" data-name="BFI IMAX Waterloo" data-city="London, UK" class="sr-only" />
              <div class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>LONDON, UK</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">BFI IMAX Waterloo</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">South Bank • UK Flagship 70mm</p>
            </label>

            <!-- Chicago -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="chicago-regal" data-name="Regal City North IMAX" data-city="Chicago, IL" class="sr-only" />
              <div class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>CHICAGO, IL</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">Regal City North IMAX</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">Western Ave • RPX Large Format</p>
            </label>

            <!-- Toronto -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="toronto-scotia" data-name="Scotiabank Theatre IMAX" data-city="Toronto, ON" class="sr-only" />
              <div class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>TORONTO, ON</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">Scotiabank Theatre IMAX</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">Richmond St • Canadian Premiere</p>
            </label>

            <!-- Atlanta -->
            <label class="theater-card p-3.5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] cursor-pointer hover:bg-[var(--intel-elevated)] transition-all select-none">
              <input type="radio" name="theater-location" value="atlanta-regal" data-name="Regal Atlantic Station IMAX" data-city="Atlanta, GA" class="sr-only" />
              <div class="flex items-center gap-1.5 text-xs font-mono text-neutral-400 font-bold mb-1">
                <MapPin class="w-3.5 h-3.5" />
                <span>ATLANTA, GA</span>
              </div>
              <h3 class="font-sans font-bold text-sm text-white leading-snug">Regal Atlantic Station</h3>
              <p class="text-[11px] text-[var(--intel-muted)] font-mono mt-1">Midtown • Pinewood Cast Hub</p>
            </label>
          </div>
        </section>

        <!-- STEP 3: SELECT 18 DEC SHOWTIMES -->
        <section class="p-6 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)]" aria-labelledby="showtime-heading">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-[var(--intel-border-subtle)]">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-xs bg-[var(--intel-red)] text-white text-xs font-mono font-bold flex items-center justify-center">3</span>
              <div>
                <h2 id="showtime-heading" class="font-display text-lg font-bold text-white tracking-wide uppercase">
                  Select Friday, 18 December 2026 Showtime
                </h2>
                <p class="text-xs text-[var(--intel-muted)] font-mono">Opening Night &amp; Midnight Incursion Schedule</p>
              </div>
            </div>
            <span class="text-xs font-mono text-[var(--intel-muted)]">Step 3 of 5</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" role="radiogroup" aria-label="18 Dec Showtimes">
            <!-- 5:00 PM -->
