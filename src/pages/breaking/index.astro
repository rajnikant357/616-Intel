---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles } from '../../utils/content';
import { Zap } from '@lucide/astro';

const allArticles = await getAllArticles();
const breakingArticles = allArticles.slice(0, 18);
const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Breaking News', item: `${siteUrl}/breaking` },
  ],
};
---

<BaseLayout
  title="Breaking Marvel News & Urgent Dispatches | 616 Intel"
  description="Developing Marvel entertainment reports, urgent productions updates, and priority articles."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Priority Dispatches' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-[var(--intel-red)] uppercase tracking-wider">
        <Zap class="w-4 h-4 fill-current animate-pulse" aria-hidden="true" />
        <span>PRIORITY DISPATCH STREAM</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Priority Marvel News &amp; Urgent Dispatches
      </h1>
      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-2xl mt-4">
        Urgent developments across Marvel Studios, Avengers: Doomsday production logistics, and competitive gaming releases.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {breakingArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
