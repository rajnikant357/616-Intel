---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles, getAllCategories, type ArticleEntry } from '../../utils/content';
import { Layers, Swords, Shield, Sparkles, Gamepad2, ShoppingBag, ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const allArticles = await getAllArticles();
  const allCategoryNames = await getAllCategories();

  const categoryMetadata: Record<string, { slug: string; desc: string }> = {
    'Superhero Action & Concepts': {
      slug: 'superhero-action-concepts',
      desc: 'Core combat theory, team choreography, weaponry, superpowers, and multiversal dynamics.',
    },
    'Marvel Characters & Teams': {
      slug: 'marvel-characters-teams',
      desc: 'Comprehensive character dossiers for heroes, villains, mutants, and superhero alliances.',
    },
    'Avengers & Cinematic Universe': {
      slug: 'avengers-cinematic-universe',
      desc: 'Theatrical productions, Phase 6 roadmaps, Avengers: Doomsday, and chronological viewing orders.',
    },
    'Gaming, Digital & Web Media': {
      slug: 'gaming-digital-web-media',
      desc: 'Competitive gaming, Marvel Rivals patch notes, season updates, webtoons, and digital media.',
    },
    'Collectibles, Merchandising & Industry': {
      slug: 'collectibles-merchandising-industry',
      desc: 'LEGO building systems, Funko collectibles, corporate equity history, and box office presales.',
    },
  };

  const slugify = (str: string) => str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

  return allCategoryNames.map((catName) => {
    const meta = categoryMetadata[catName] || {
      slug: slugify(catName),
      desc: `Comprehensive Marvel intelligence dispatches and dossiers covering ${catName}.`,
    };

    const articles = allArticles.filter((a) => a.data.category.toLowerCase() === catName.toLowerCase());

    return {
      params: { slug: meta.slug },
      props: {
        categoryName: catName,
        description: meta.desc,
        articles,
      },
    };
  });
}

interface Props {
  categoryName: string;
  description: string;
  articles: ArticleEntry[];
}

const { categoryName, description, articles } = Astro.props;

const categoryIcons: Record<string, any> = {
  'Superhero Action & Concepts': Swords,
  'Marvel Characters & Teams': Shield,
  'Avengers & Cinematic Universe': Sparkles,
  'Gaming, Digital & Web Media': Gamepad2,
  'Collectibles, Merchandising & Industry': ShoppingBag,
};

const Icon = categoryIcons[categoryName] || Layers;

const siteUrl = 'https://616intel.com';
const currentSlug = Astro.params.slug;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${categoryName} — 616 Intel`,
  description,
  url: `${siteUrl}/categories/${currentSlug}`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: `${siteUrl}/categories` },
    { '@type': 'ListItem', position: 3, name: categoryName, item: `${siteUrl}/categories/${currentSlug}` },
  ],
};
---

<BaseLayout
  title={`${categoryName} | Marvel Leaks & Rumors | 616 Intel`}
  description={description}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Categories', href: '/categories' },
        { label: categoryName },
      ]}
    />

    <!-- Category Header -->
    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-[var(--intel-red)] uppercase tracking-wider">
        <Icon class="w-4 h-4" aria-hidden="true" />
        <span>TOPIC DOSSIER WIRE</span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
            {categoryName}
          </h1>
          <p class="text-sm sm:text-base text-neutral-300 font-sans mt-2 max-w-3xl">
            {description}
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 px-3 py-1.5 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)] text-xs font-mono text-neutral-300">
          <span class="w-2 h-2 rounded-full bg-[var(--intel-red)] animate-pulse"></span>
          <span>{articles.length} Dispatches</span>
        </div>
      </div>

      <div class="mt-6 flex items-center gap-4 text-xs font-mono">
        <a
          href="/categories"
          class="inline-flex items-center gap-1.5 text-[var(--intel-muted)] hover:text-white transition-colors"
        >
          <ArrowLeft class="w-3.5 h-3.5" aria-hidden="true" />
          <span>Browse All Categories</span>
        </a>
      </div>
    </header>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt || article.data.description,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
