---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { getAllArticles, getAllCategories } from '../../utils/content';
import { Layers, Swords, Shield, Sparkles, Gamepad2, ShoppingBag } from '@lucide/astro';

const allArticles = await getAllArticles();
const categories = await getAllCategories();

const categoryIcons: Record<string, any> = {
  'Superhero Action & Concepts': Swords,
  'Marvel Characters & Teams': Shield,
  'Avengers & Cinematic Universe': Sparkles,
  'Gaming, Digital & Web Media': Gamepad2,
  'Collectibles, Merchandising & Industry': ShoppingBag,
};

const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: `${siteUrl}/categories` },
  ],
};
---

<BaseLayout
  title="Intel Categories & Topic Domains | 616 Intel"
  description="Explore 616 Intel by category: Superhero Action & Concepts, Marvel Characters, Avengers, Gaming, and Collectibles."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Categories' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-[var(--intel-red)] uppercase tracking-wider">
        <Layers class="w-4 h-4" aria-hidden="true" />
        <span>TOPIC TAXONOMY</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        Intel Categories &amp; Topics
      </h1>
      <p class="text-sm sm:text-base text-neutral-300 font-sans mt-2 max-w-2xl">
        All {allArticles.length} dispatches systematically classified into 5 primary subject domains for fast investigation and discovery.
      </p>
    </header>

    <div class="space-y-12">
      {categories.map((cat) => {
        const catArticles = allArticles.filter((a) => a.data.category === cat);
        const Icon = categoryIcons[cat] || Layers;
        return (
          <section class="border border-[var(--intel-border)] bg-[var(--intel-charcoal)]/40 rounded-xs p-6 sm:p-8">
            <div class="flex items-center justify-between pb-4 mb-6 border-b border-[var(--intel-border)]">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-xs bg-[var(--intel-red)]/20 text-[var(--intel-red)]">
                  <Icon class="w-5 h-5" aria-hidden="true" />
                </div>
                <h2 class="font-serif text-xl sm:text-2xl font-bold text-white">
                  {cat}
                </h2>
              </div>
              <span class="text-xs font-mono text-[var(--intel-muted)] font-bold">
                {catArticles.length} ARTICLES
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {catArticles.map((art) => (
                <a
                  href={`/articles/${art.data.slug}`}
                  class="p-3 rounded-xs bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] hover:border-neutral-500 transition-colors flex items-center justify-between group"
                >
                  <span class="font-serif text-sm text-neutral-200 group-hover:text-blue-400 font-medium truncate">
                    {art.data.title}
                  </span>
                  <span class="text-xs text-[var(--intel-muted)] font-mono ml-2 shrink-0">
                    &rarr;
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
