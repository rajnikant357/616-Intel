---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getArticlesByCategory } from '../../utils/content';
import { Users } from '@lucide/astro';

const characterArticles = await getArticlesByCategory('Marvel Characters & Teams');
const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Characters', item: `${siteUrl}/characters` },
  ],
};
---

<BaseLayout
  title="Marvel Character Dossiers & Profiles | 616 Intel"
  description="Authoritative character dossiers covering Marvel heroes, villains, mutants, Fantastic Four, and Avengers."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Character Dossiers' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[var(--intel-red)]/15 border border-[var(--intel-red)]/40 text-[var(--intel-red)] font-mono text-xs font-bold uppercase tracking-widest mb-3">
        <Users class="w-3.5 h-3.5" aria-hidden="true" />
        <span>CHARACTER DOSSIER ARCHIVE</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Marvel Character Dossiers &amp; Profiles
      </h1>

      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-2xl mt-4">
        Exhaustive profiles documenting comic book origins, superhero action abilities, weapons, alliances, and multiversal transformations.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {characterArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
