---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles } from '../../utils/content';
import { CircleCheck } from '@lucide/astro';

const allArticles = await getAllArticles();
const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Confirmed Reports', item: `${siteUrl}/confirmed` },
  ],
};
---

<BaseLayout
  title="Confirmed Marvel Reports & Verified Receipts | 616 Intel"
  description="Reports corroborated by official press releases, studio filings, and verified production records."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Confirmed Reports' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
        <CircleCheck class="w-4 h-4 text-emerald-400" aria-hidden="true" />
        <span>CONFIRMED INTELLIGENCE LEDGER</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Confirmed Marvel Reports &amp; Verified Entries
      </h1>
      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-3xl mt-4">
        Every entry in this section has been validated against documentary proof: comic publications, trade reports, and studio releases.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
