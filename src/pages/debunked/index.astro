---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles } from '../../utils/content';
import { CircleX } from '@lucide/astro';

const allArticles = await getAllArticles();
const displayArticles = allArticles.slice(0, 12);
const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Fact-Check & Clarifications', item: `${siteUrl}/debunked` },
  ],
};
---

<BaseLayout
  title="Fact-Check & Clarifications Desk | 616 Intel"
  description="Investigating misleading claims, AI rumors, and timeline misconceptions across Marvel media."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Fact-Check & Clarifications' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-red-400 uppercase tracking-wider">
        <CircleX class="w-4 h-4 text-red-400" aria-hidden="true" />
        <span>FACT-CHECK &amp; CLARIFICATIONS DESK</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Fact-Check &amp; Lore Clarifications
      </h1>
      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-3xl mt-4">
        Exposing fabricated claims, inaccurate leaks, and misattributed multiverse rumors with verified documentary receipts.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
