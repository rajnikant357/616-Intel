---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles, getAllCategories } from '../../utils/content';
import { BookOpen } from '@lucide/astro';

const allArticles = await getAllArticles();
const categories = await getAllCategories();

const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'All Leaks & Reports', item: `${siteUrl}/latest` },
  ],
};
---

<BaseLayout
  title={`All Marvel Leaks & Reports (${allArticles.length} Entries) | 616 Intel`}
  description={`Comprehensive archive of all ${allArticles.length} Marvel leaks, rumors, Avengers: Doomsday scoops, and superhero action dispatches.`}
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire' },
        { label: 'All Leaks & Reports' },
      ]}
    />

    <!-- Archive Header -->
    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-[var(--intel-red)] uppercase tracking-wider">
        <BookOpen class="w-4 h-4" aria-hidden="true" />
        <span>MARVEL LEAKS &amp; INTELLIGENCE WIRE</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
        All Marvel Leaks &amp; Reports
      </h1>
      <p class="text-sm sm:text-base text-neutral-300 font-sans mt-2 max-w-2xl">
        Complete intelligence archive of {allArticles.length} detailed dispatches exploring Marvel rumors, Doctor Doom scoops, Avengers: Doomsday soundstage leaks, and multiverse combat.
      </p>

      <!-- Category Filter Links -->
      <div class="flex flex-wrap items-center gap-2 mt-6">
        <a
          href="/latest"
          class="px-3 py-1.5 rounded-xs text-xs font-mono font-bold bg-[var(--intel-red)] text-white"
        >
          ALL ({allArticles.length})
        </a>
        {categories.map((cat) => (
          <a
            href={`/categories`}
            class="px-3 py-1.5 rounded-xs text-xs font-mono bg-[var(--intel-charcoal)] hover:bg-[var(--intel-elevated)] border border-[var(--intel-border)] text-neutral-300 hover:text-white transition-colors"
          >
            {cat}
          </a>
        ))}
      </div>
    </header>

    <!-- Articles Feed Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
