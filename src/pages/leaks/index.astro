---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles } from '../../utils/content';
import { ShieldAlert } from '@lucide/astro';

const allArticles = await getAllArticles();
const displayArticles = allArticles.slice(0, 18);

const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Leaks & Dossiers', item: `${siteUrl}/leaks` },
  ],
};
---

<BaseLayout
  title="Marvel Leaks & Confidential Dossiers | 616 Intel"
  description="Unofficial Marvel reports, production milestones, script analyses, and multiverse tracking."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs items={[{ label: 'Intel Wire', href: '/latest' }, { label: 'Leaks & Dossiers' }]} />

    <header class="mb-8 pb-6 border-b border-[var(--intel-border)]">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[var(--intel-red)]/15 border border-[var(--intel-red)]/40 text-[var(--intel-red)] font-mono text-xs font-bold uppercase tracking-widest mb-3">
        <ShieldAlert class="w-3.5 h-3.5" aria-hidden="true" />
        <span>UNOFFICIAL DOSSIERS &amp; LEAKS</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Marvel Leaks &amp; Production Intelligence
      </h1>

      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-2xl mt-4">
        Investigative reports exploring pre-vis concepts, production rumors, and unreleased storylines.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
