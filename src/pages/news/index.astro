---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { getAllArticles } from '../../utils/content';
import { Newspaper } from '@lucide/astro';

const allArticles = await getAllArticles();

const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'News', item: `${siteUrl}/news` },
  ],
};
---

<BaseLayout
  title="Marvel News & Superhero Lore | 616 Intel"
  description="Verified superhero news, studio dispatches, and Marvel leaks intelligence."
  jsonLd={breadcrumbSchema}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs items={[{ label: 'News' }]} />

    <header class="mb-8 pb-6 border-b border-[var(--intel-border)]">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-white/5 border border-white/10 text-slate-300 font-mono text-xs font-bold uppercase tracking-widest mb-3">
        <Newspaper class="w-3.5 h-3.5 text-[var(--intel-red)]" aria-hidden="true" />
        <span>MARVEL NEWS WIRE</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Marvel News &amp; Dispatches
      </h1>

      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-2xl mt-4">
        Direct reporting, studio confirmations, theatrical release schedules, and insider analyses.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allArticles.map((article) => (
        <ArticleCard
          article={{
            slug: `/articles/${article.data.slug}`,
            title: article.data.title,
            excerpt: article.data.excerpt,
            category: article.data.category,
            readingTime: article.data.readingTime,
            author: article.data.author,
          }}
          variant="standard"
        />
      ))}
    </div>
  </div>
</BaseLayout>
