---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { ShieldCheck } from '@lucide/astro';
---

<BaseLayout
  title="Privacy Policy — 616 INTEL Leaks & Rumors Wire"
  description="Transparent data privacy practices and zero-tracking architecture for 616 Intel Marvel Leaks & Rumors Wire."
>
  <div class="container-editorial py-6 md:py-10 max-w-4xl mx-auto">
    <Breadcrumbs
      items={[
        { label: 'Compliance' },
        { label: 'Privacy Policy' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
        <ShieldCheck class="w-4 h-4 text-emerald-400" aria-hidden="true" />
        <span>DATA PROTECTION &amp; PRIVACY</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
        PRIVACY POLICY
      </h1>
      <p class="text-xs sm:text-sm text-neutral-400 mt-2 font-mono">
        Effective Date: October 2026 • Zero-Tracking, Static-First Reading Architecture.
      </p>
    </header>

    <div class="space-y-8 text-neutral-300 font-sans leading-relaxed text-sm sm:text-base">
      <section class="p-5 rounded-xs border border-emerald-500/30 bg-emerald-950/20">
        <h2 class="text-lg font-serif font-bold text-emerald-300 tracking-tight mb-2">
          Core Commitment: Zero Account Tracking &amp; Zero Media Bloat
        </h2>
        <p class="text-xs sm:text-sm text-neutral-200 leading-relaxed">
          616 Intel does not require user accounts, passwords, social logins, credit card transactions, or personal profile tracking. We operate as an open, static-first Marvel rumor and leaks publication.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-serif font-bold text-white tracking-tight mb-3">
          1. Information We Do Not Collect
        </h2>
        <p>
          We do not collect names, email addresses, phone numbers, location tracking, or financial data. We do not sell, rent, or monetize personal reader information.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-serif font-bold text-white tracking-tight mb-3">
          2. Server Logs &amp; Caching
        </h2>
        <p>
          Like all standard web servers, anonymous technical request headers (such as IP addresses and browser user-agent strings) may be processed transiently by our edge delivery network strictly for DDoS mitigation, caching performance, and server health monitoring.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
