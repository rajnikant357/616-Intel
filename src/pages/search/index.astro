---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { getAllArticles } from '../../utils/content';
import { Search } from '@lucide/astro';

const allArticles = await getAllArticles();

// Pre-serialize search index
const searchIndex = allArticles.map((a) => ({
  title: a.data.title,
  slug: a.data.slug,
  description: a.data.description,
  excerpt: a.data.excerpt || '',
  category: a.data.category,
  readingTime: a.data.readingTime || '2 min',
  tags: a.data.tags || [],
}));

const siteUrl = 'https://616intel.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Search', item: `${siteUrl}/search` },
  ],
};
---

<BaseLayout
  title="Search Marvel Rumors, Leaks & Articles | 616 Intel"
  description="Search across 276 Marvel leaks, rumors, and dossiers covering Doctor Doom, Avengers: Doomsday, and superhero action."
  jsonLd={[breadcrumbSchema]}
>
  <div class="container-editorial py-6 md:py-10">
    <Breadcrumbs items={[{ label: 'Intel Wire' }, { label: 'Search' }]} />

    <!-- Hero Search Bar -->
    <header class="mb-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[var(--intel-red)]/15 border border-[var(--intel-red)]/40 text-[var(--intel-red)] font-mono text-xs font-bold uppercase tracking-widest mb-3">
        <Search class="w-3.5 h-3.5" aria-hidden="true" />
        <span>MARVEL SEARCH ENGINE</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
        Search Marvel Rumors &amp; Leaks
      </h1>
      <p class="text-sm sm:text-base text-neutral-300 font-sans mb-6">
        Search canonical articles, casting leaks, production rumors, and Doctor Doom Avengers: Doomsday scoops.
      </p>

      <div class="relative">
        <Search class="w-5 h-5 text-[var(--intel-red)] absolute left-4 top-4 pointer-events-none" aria-hidden="true" />
        <input
          id="search-input"
          type="search"
          placeholder="Search keywords (e.g. Doctor Doom, Avengers Doomsday, Marvel Rivals, Sentry)..."
          class="w-full pl-12 pr-4 py-3.5 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)] hover:border-neutral-500 text-white placeholder:text-[var(--intel-muted)] font-mono text-sm focus-visible:outline-none focus-visible:border-[var(--intel-red)] shadow-sm"
          autocomplete="off"
        />
      </div>

      <div id="result-count" class="mt-3 text-xs font-mono text-[var(--intel-muted)]">
        Showing all {allArticles.length} indexed articles
      </div>
    </header>

    <!-- Results Container -->
    <div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {searchIndex.map((item) => (
        <article
          data-title={item.title.toLowerCase()}
          data-desc={item.description.toLowerCase()}
          data-cat={item.category.toLowerCase()}
          data-tags={item.tags.join(' ').toLowerCase()}
          class="article-item p-5 rounded-xs bg-[var(--intel-charcoal)] border border-[var(--intel-border)] hover:border-neutral-500 transition-colors flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-mono text-blue-400 uppercase font-bold">
                {item.category}
              </span>
              <span class="text-[10px] font-mono text-[var(--intel-muted)]">
                {item.readingTime}
              </span>
            </div>
            <h3 class="font-serif text-base sm:text-lg font-bold text-white hover:text-[var(--intel-red)] transition-colors mb-2">
              <a href={`/articles/${item.slug}`}>
                {item.title}
              </a>
            </h3>
            <p class="text-xs text-neutral-300 font-sans leading-relaxed line-clamp-3 mb-4">
              {item.excerpt || item.description}
            </p>
          </div>
          <div class="pt-3 border-t border-[var(--intel-border-subtle)] text-xs font-mono text-[var(--intel-red)] font-semibold flex items-center justify-between">
            <a href={`/articles/${item.slug}`} class="hover:underline">
              Read Entry &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-16 text-neutral-400 font-mono text-sm">
      No articles matched your search query. Try another keyword.
    </div>
  </div>
</BaseLayout>

<script>
  function setupSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const grid = document.getElementById('results-grid');
    const noResults = document.getElementById('no-results');
    const countLabel = document.getElementById('result-count');
    if (!input || !grid || !noResults || !countLabel) return;

    const targetGrid = grid;
    const targetNoResults = noResults;
    const targetCountLabel = countLabel;

    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (initialQuery) {
      input.value = initialQuery;
      filter(initialQuery);
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      filter(q);
    });

    function filter(q: string) {
      const items = targetGrid.querySelectorAll('.article-item');
      let visible = 0;

      items.forEach((item) => {
        const el = item as HTMLElement;
        const title = el.dataset.title || '';
        const desc = el.dataset.desc || '';
        const cat = el.dataset.cat || '';
        const tags = el.dataset.tags || '';

        if (!q || title.includes(q) || desc.includes(q) || cat.includes(q) || tags.includes(q)) {
          el.style.display = '';
          visible++;
        } else {
          el.style.display = 'none';
        }
      });

      targetCountLabel.textContent = `Found ${visible} matching ${visible === 1 ? 'article' : 'articles'}`;
      if (visible === 0) {
        targetNoResults.classList.remove('hidden');
      } else {
        targetNoResults.classList.add('hidden');
      }
    }
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
