---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { Scale, TriangleAlert } from '@lucide/astro';
---

<BaseLayout
  title="Terms of Use — 616 INTEL Marvel Leaks & Rumors Wire"
  description="Terms of use governing access and reading of the 616 Intel Marvel leaks, rumors, and news dispatches."
>
  <div class="container-editorial py-6 md:py-10 max-w-4xl mx-auto">
    <Breadcrumbs
      items={[
        { label: 'Compliance' },
        { label: 'Terms of Use' },
      ]}
    />

    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-[var(--intel-red)] uppercase tracking-wider">
        <Scale class="w-4 h-4 text-[var(--intel-red)]" aria-hidden="true" />
        <span>PUBLICATION POLICIES</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
        TERMS OF USE
      </h1>
      <p class="text-xs sm:text-sm text-neutral-400 mt-2 font-mono">
        Effective Date: October 2026 • 616 Intel Leaks &amp; Rumors Wire.
      </p>
    </header>

    <!-- Independent Marvel Disclaimer Callout -->
    <div class="mb-8 p-5 rounded-xs border border-amber-500/40 bg-amber-950/20 text-xs font-mono text-amber-200">
      <div class="flex items-center gap-2 font-bold uppercase text-amber-400 mb-2">
        <TriangleAlert class="w-4 h-4 shrink-0" />
        <span>Independent Marvel Publication Notice</span>
      </div>
      <p class="leading-relaxed">
        616 Intel is an independent Marvel fan news and rumor intelligence publication and is not affiliated with Marvel Entertainment, Marvel Studios, Disney, DC Comics, or their subsidiaries. All character names, logos, and trademarks remain the exclusive property of their respective holders.
      </p>
    </div>

    <div class="space-y-8 text-neutral-300 font-sans leading-relaxed text-sm sm:text-base">
      <section>
        <h2 class="text-xl font-serif font-bold text-white tracking-tight mb-3">
          1. Acceptance of Terms
        </h2>
        <p>
          By accessing, reading, or submitting articles on 616 Intel, you agree to these Terms of Use. The publication is provided for informational, entertainment, news commentary, and community discussion purposes.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-serif font-bold text-white tracking-tight mb-3">
          2. Intellectual Property &amp; Fair Use
        </h2>
        <p>
          All rumor analysis, investigative reporting, synthesis, and original commentary published on 616 Intel are protected by international copyright laws. References to comic books, characters, fictional elements, leaks, and cinematic titles are made under the doctrine of nominative fair use for descriptive, critical, and news commentary purposes.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-serif font-bold text-white tracking-tight mb-3">
          3. Disclaimer of Warranties &amp; Rumor Nature
        </h2>
        <p>
          Reports marked as "RUMOR", "LEAK", or "UNVERIFIED" reflect ongoing industry whispers, casting speculation, soundstage leaks, or production reports. While our editorial desk strives for rigorous investigative context across all 344 indexed articles, rumors and leaks are inherently subject to change by studios and filmmakers.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
