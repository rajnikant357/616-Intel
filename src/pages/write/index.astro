---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import { SquarePen, ShieldAlert, Send, CircleCheck } from '@lucide/astro';

const categories = [
  'Rumors & Scoops',
  'Leaks & Spoilers',
  'Casting Intel',
  'Plot Theories',
  'Movie News',
  'Comic Lore',
  'Marvel Rivals & Gaming',
];
---

<BaseLayout
  title="Submit a Marvel Leak, Rumor or Scoop | 616 Intel"
  description="Share your Marvel rumors, leaks, casting whispers, and multiverse theories with the 616 Intel community. Text-first reporting with zero file uploads."
>
  <div class="container-editorial py-6 md:py-10 max-w-4xl mx-auto">
    <Breadcrumbs
      items={[
        { label: 'Intel Wire', href: '/latest' },
        { label: 'Submit Intel' },
      ]}
    />

    <!-- Header Block -->
    <header class="pb-6 mb-8 border-b border-[var(--intel-border)]">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xs bg-[var(--intel-red)]/15 border border-[var(--intel-red)]/40 text-[var(--intel-red)] font-mono text-xs font-bold uppercase tracking-widest mb-3">
        <SquarePen class="w-3.5 h-3.5" aria-hidden="true" />
        <span>FAN INTEL SUBMISSION WIRE</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-none mb-3">
        Submit a Marvel Leak or Rumor
      </h1>

      <p class="font-sans text-sm sm:text-base text-neutral-300 max-w-2xl mt-4">
        Where Marvel fans gather to share and read insider scoops. No account required. Zero file uploads needed—just pure text reporting and analysis.
      </p>
    </header>

    <!-- Submission Guidelines Alert -->
    <div class="mb-8 p-4 rounded-xs border border-amber-500/30 bg-amber-950/20 text-xs font-mono text-amber-200 flex items-start gap-3">
      <ShieldAlert class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" aria-hidden="true" />
      <div>
        <strong class="text-amber-300 uppercase block mb-1">Text-Only Intel Policy:</strong>
        To protect source anonymity and prevent media copyright issues, file and image uploads are completely disabled. Please describe your scoop or leak in clear, detailed text.
      </div>
    </div>

    <!-- The Text-Only Writing Form -->
    <form id="intel-submit-form" class="space-y-6 bg-[var(--intel-charcoal)] p-6 sm:p-8 rounded-xs border border-[var(--intel-border)]">
      <div>
        <label for="title" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
          Dispatch Title *
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          placeholder="e.g. Doctor Doom Armor Variant Revealed for Avengers: Doomsday Soundstages"
          class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-sans text-base focus:outline-none"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="category" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
            Category *
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-sans text-sm focus:outline-none"
          >
            {categories.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="status" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
            Intel Verification Status *
          </label>
          <select
            id="status"
            name="status"
            required
            class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-sans text-sm focus:outline-none"
          >
            <option value="RUMORED">RUMORED (Casting or Plot Whisper)</option>
            <option value="UNVERIFIED">UNVERIFIED (Social or Anonymous Leak)</option>
            <option value="REPORTED">REPORTED (Trade or Industry Filing)</option>
            <option value="THEORY">THEORY (Fan Analysis / Speculation)</option>
            <option value="CONFIRMED">CONFIRMED (Studio or Producer Statement)</option>
          </select>
        </div>
      </div>

      <div>
        <label for="author" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
          Your Alias or Pen Name *
        </label>
        <input
          type="text"
          id="author"
          name="author"
          required
          placeholder="e.g. Earth-616 Scout, Latverian Emissary"
          class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-sans text-sm focus:outline-none"
        />
      </div>

      <div>
        <label for="content" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
          Intel Report / Article Body * (Markdown Supported)
        </label>
        <textarea
          id="content"
          name="content"
          rows="10"
          required
          placeholder="Provide detailed breakdown of the leak, scoop, or rumor. Include context, character names, location, and why it matters to the MCU..."
          class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-serif text-base leading-relaxed focus:outline-none"
        ></textarea>
        <span class="text-[11px] font-mono text-neutral-400 mt-1 block">
          Format with headings (## Heading), bullet points, and paragraphs. No image uploads needed.
        </span>
      </div>

      <div>
        <label for="tags" class="block text-xs font-mono text-neutral-300 uppercase font-bold mb-2">
          Indexed Keywords / Tags (Comma separated)
        </label>
        <input
          type="text"
          id="tags"
          name="tags"
          placeholder="Doctor Doom, Avengers Doomsday, Robert Downey Jr, Phase 6"
          class="w-full px-4 py-3 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] focus:border-[var(--intel-red)] text-white font-mono text-xs focus:outline-none"
        />
      </div>

      <div class="pt-4 border-t border-[var(--intel-border)] flex items-center justify-between">
        <span class="text-xs font-mono text-neutral-400">
          Instant Community Dispatch
        </span>
        <button
          type="submit"
          class="px-6 py-3 rounded-xs bg-[var(--intel-red)] hover:bg-red-700 text-white font-mono text-xs font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-md cursor-pointer"
        >
          <Send class="w-4 h-4" aria-hidden="true" />
          <span>Publish Dispatch &rarr;</span>
        </button>
      </div>
    </form>

    <!-- Success Modal / Card -->
    <div id="publish-success" class="hidden mt-8 p-6 rounded-xs bg-emerald-950/40 border border-emerald-500/40 text-neutral-200">
      <div class="flex items-center gap-3 text-emerald-400 font-serif text-xl font-bold mb-2">
        <CircleCheck class="w-6 h-6 shrink-0" />
        <span>Dispatch Successfully Submitted!</span>
      </div>
      <p class="text-sm font-sans mb-4">
        Your Marvel intel has been verified and stored in your local intelligence feed. Fans can read your submission below:
      </p>
      <div id="submitted-preview" class="p-5 rounded-xs bg-[var(--intel-obsidian)] border border-[var(--intel-border)] mt-4">
        <!-- Rendered dynamically -->
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupWriteForm() {
    const form = document.getElementById('intel-submit-form') as HTMLFormElement | null;
    const successCard = document.getElementById('publish-success');
    const previewBox = document.getElementById('submitted-preview');
    if (!form || !successCard || !previewBox) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const title = String(formData.get('title') || '');
      const category = String(formData.get('category') || '');
      const status = String(formData.get('status') || '');
      const author = String(formData.get('author') || '');
      const content = String(formData.get('content') || '');
      const tags = String(formData.get('tags') || '').split(',').map((t) => t.trim()).filter(Boolean);

      const dispatch = {
        title,
        category,
        status,
        author,
        content,
        tags,
        date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
      };

      // Store in localStorage for user session
      try {
        const stored = JSON.parse(localStorage.getItem('user_intel_dispatches') || '[]');
        stored.unshift(dispatch);
        localStorage.setItem('user_intel_dispatches', JSON.stringify(stored));
      } catch (err) {
        console.error('Storage error', err);
      }

      // Display preview in Wikipedia article layout without info or buttons
      previewBox.innerHTML = `
        <div class="border-b border-neutral-700 pb-2 mb-3">
          <h2 class="font-serif text-2xl text-white font-normal">${title}</h2>
          <p class="italic text-xs text-neutral-400 font-serif mt-1">From 616 Intel, independent Marvel leaks and rumor wire</p>
          <div class="text-xs font-mono text-neutral-400 mt-2">
            <span>By ${author}</span> • <span>Category: ${category}</span> • <span>Status: ${status}</span> • <span>${dispatch.date}</span>
          </div>
        </div>
        <div class="font-serif text-neutral-200 text-sm leading-relaxed whitespace-pre-line py-2">
          ${content}
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-800 text-xs font-mono text-neutral-400">
          Categories: <span class="text-blue-400">${category}</span> ${tags.length > 0 ? '| ' + tags.join(' | ') : ''}
        </div>
      `;

      successCard.classList.remove('hidden');
      form.reset();
      window.scrollTo({ top: successCard.offsetTop - 80, behavior: 'smooth' });
    });
  }

  setupWriteForm();
  document.addEventListener('astro:page-load', setupWriteForm);
</script>
